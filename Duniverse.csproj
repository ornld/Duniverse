<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This project file sits at the repo root, so its globs reach into every sibling folder
         unless told otherwise. Each new project has to be named here or the console app tries to
         compile it as part of itself and the build dies on duplicate assembly attributes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Duniverse.Core/**;Duniverse.Web/**;Duniverse.Prerender/**;Duniverse.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Duniverse.Core/Duniverse.Core.csproj" />
  </ItemGroup>

</Project>
