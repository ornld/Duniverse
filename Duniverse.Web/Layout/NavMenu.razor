@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<nav class="top-nav tab-glow" inert="@Inert">
    @* One table behind both faces of the nav: these render as tabs at width and as
       the Contents panel on a phone, so a renamed page renames itself in both. *@
    @for (int i = 0; i < Pages.Length; i++)
    {
        var tab = Pages[i];
        <NavLink href="@tab.Path">@tab.Label</NavLink>

        @* I break the rows by hand instead of letting text run out. These spans sleep
           at desktop and wake under 920px, where tabs land in threes. *@
        @if (i is 2 or 5)
        {
            <span class="nav-break" aria-hidden="true"></span>
        }
    }

    @* A book carries a contents at the front and an index at the back. Phones show
       both, since nine tabs cost four rows there; wider screens keep the tabs. *@
    <div class="nav-contents @(contentsOpen ? "open" : "")" @onkeydown="OnKeyDown">
        <button type="button" class="index-trigger @(IsContentsPage ? "active" : "")"
                aria-haspopup="true" aria-expanded="@(contentsOpen ? "true" : "false")" @onclick="ToggleContents">
            <span class="index-label">Contents</span>
            <svg class="index-chevron" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        @if (contentsOpen)
        {
            <div class="index-backdrop" @onclick="Close"></div>
            <div class="index-panel">
                <canvas class="index-sand" @ref="contentsCanvas"></canvas>
                <div class="index-seam"></div>
                <ul>
                    @* Each row takes its own copy. A link's inner content renders after
                       the loop has moved on, so reading the counter there runs off the end. *@
                    @for (int i = 0; i < Pages.Length; i++)
                    {
                        var tab = Pages[i];
                        var order = i;
                        <li style="--i: @order"><NavLink href="@tab.Path"><span class="index-label">@tab.Label</span></NavLink></li>
                    }
                </ul>
            </div>
        }
    </div>

    <span class="nav-divider"></span>
    <div class="nav-index @(open ? "open" : "")" @onkeydown="OnKeyDown">
        @* aria-expanded is a string on purpose. Hand Blazor the bool and it treats it
           like a checkbox's checked: false drops the attribute, true writes it empty,
           so a screen reader never hears whether this panel is open. *@
        <button type="button" class="index-trigger @(IsIndexPage ? "active" : "")"
                aria-haspopup="true" aria-expanded="@(open ? "true" : "false")" @onclick="Toggle">
            <span class="index-label">Index</span>
            <svg class="index-chevron" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        @if (open)
        {
            <div class="index-backdrop" @onclick="Close"></div>
            <div class="index-panel">
                <canvas class="index-sand" @ref="sandCanvas"></canvas>
                <div class="index-seam"></div>
                <ul>
                    @* Each drawer carries its own mark, tinted from --cat-color. All ten
                       colors only sit together here. *@
                    @* The label needs its own span: on the whole link, the Eyes of Ibad
                       glow bled over the mark and turned it blue. *@
                    <li style="--i: 0" class="category-artifacts"><NavLink href="/category/artifacts"><Mark Name="artifacts" CssClass="index-mark" /><span class="index-label">Artifact</span></NavLink></li>
                    <li style="--i: 1" class="category-disciplines"><NavLink href="/category/disciplines"><Mark Name="disciplines" CssClass="index-mark" /><span class="index-label">Discipline</span></NavLink></li>
                    <li style="--i: 2" class="category-flora-fauna"><NavLink href="/category/flora-fauna"><Mark Name="flora-fauna" CssClass="index-mark" /><span class="index-label">Flora & Fauna</span></NavLink></li>
                    <li style="--i: 3" class="category-historical-events"><NavLink href="/category/historical-events"><Mark Name="historical-events" CssClass="index-mark" /><span class="index-label">Historical Event</span></NavLink></li>
                    <li style="--i: 4" class="category-houses"><NavLink href="/category/houses"><Mark Name="houses" CssClass="index-mark" /><span class="index-label">House</span></NavLink></li>
                    <li style="--i: 5" class="category-organizations"><NavLink href="/category/organizations"><Mark Name="organizations" CssClass="index-mark" /><span class="index-label">Organization</span></NavLink></li>
                    <li style="--i: 6" class="category-personas"><NavLink href="/category/personas"><Mark Name="personas" CssClass="index-mark" /><span class="index-label">Persona</span></NavLink></li>
                    <li style="--i: 7" class="category-theological-systems"><NavLink href="/category/theological-systems"><Mark Name="theological-systems" CssClass="index-mark" /><span class="index-label">Theological System</span></NavLink></li>
                    <li style="--i: 8" class="category-vehicles"><NavLink href="/category/vehicles"><Mark Name="vehicles" CssClass="index-mark" /><span class="index-label">Vehicle</span></NavLink></li>
                    <li style="--i: 9" class="category-worlds"><NavLink href="/category/worlds"><Mark Name="worlds" CssClass="index-mark" /><span class="index-label">World</span></NavLink></li>
                    @* The register is an instrument, not a drawer, so it closes the list
                       on its own row, wearing its own signet in the worlds mineral. *@
                    <li style="--i: 10" class="category-worlds index-register"><NavLink href="/fiefs"><Mark Name="siridar" CssClass="index-mark" /><span class="index-label">Siridar Register</span></NavLink></li>
                </ul>
            </div>
        }
    </div>
</nav>

@code {
    // Sealed off whenever the first-visit ritual holds the screen. A component tag cannot pass
    // a plain attribute down to my own nav element, so the layout hands it over as a parameter.
    [Parameter] public bool Inert { get; set; }

    // The nine pages, in bar order. Rendered twice from here, so the tabs and the
    // Contents panel can never drift apart.
    private static readonly (string Path, string Label)[] Pages =
    {
        ("/about", "About Dune"),
        ("/archives", "Archives"),
        ("/timeline", "Timeline"),
        ("/bloodlines", "Bloodlines"),
        ("/connections", "Connections"),
        ("/universe", "Universe"),
        ("/terminology", "Terminology"),
        ("/sayings", "Sayings"),
        ("/trial", "Mentat Trial"),
    };

    private bool open;
    private bool contentsOpen;
    private bool runSand;
    private ElementReference sandCanvas;
    private ElementReference contentsCanvas;

    // Each trigger carries the Eyes of Ibad glow whenever you stand on a page its own
    // panel opens onto, so the "blue marks where you are" rule survives the links
    // moving into a dropdown.
    private bool IsIndexPage => Nav.Uri.Contains("/category/") || Nav.Uri.Contains("/fiefs");

    // Matched on the path alone, since a query or hash still leaves you on the page.
    private bool IsContentsPage
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
            return Pages.Any(page => path.StartsWith(page.Path, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Close();
        StateHasChanged();
    }

    // Only one panel stands open at a time. Opening either shuts the other, so the
    // two never overlap on a screen this narrow.
    private void Toggle()
    {
        open = !open;
        contentsOpen = false;
        runSand = open;
    }

    private void ToggleContents()
    {
        contentsOpen = !contentsOpen;
        open = false;
        runSand = contentsOpen;
    }

    private void Close()
    {
        open = false;
        contentsOpen = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The canvas only exists when a panel is open, so the sand can only start
        // here, after the render that created it.
        if (runSand && (open || contentsOpen))
        {
            runSand = false;
            await JS.InvokeVoidAsync("duneNav.sandSettle", open ? sandCanvas : contentsCanvas);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
