@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<nav class="top-nav tab-glow">
    <NavLink href="/about">About Dune</NavLink>
    <NavLink href="/archives">Archives</NavLink>
    <NavLink href="/timeline">Timeline</NavLink>
    @* Forced wrap points that wake at phone and tablet widths: the bar breaks into
       fixed rows instead of wrapping wherever the text runs out. Tablets get three
       rows of three tabs with the Index closing the third. Phones can't fit the
       Index on the end of that third row, so a further break below 600px sends it
       down to a fourth row on its own, leaving three clean rows of three above it. *@
    <span class="nav-break" aria-hidden="true"></span>
    <NavLink href="/bloodlines">Bloodlines</NavLink>
    <NavLink href="/connections">Connections</NavLink>
    <NavLink href="/universe">Universe</NavLink>
    <span class="nav-break" aria-hidden="true"></span>
    <NavLink href="/terminology">Terminology</NavLink>
    <NavLink href="/sayings">Sayings</NavLink>
    <NavLink href="/trial">Mentat Trial</NavLink>
    <span class="nav-break-phone" aria-hidden="true"></span>
    <span class="nav-divider"></span>
    <div class="nav-index @(open ? "open" : "")" @onkeydown="OnKeyDown">
        @* aria-expanded is spelled out as a string on purpose. Handing Blazor the bool
           gets it treated like a checkbox's checked: false drops the attribute off the
           button entirely and true writes it empty, so a screen reader never once hears
           whether this panel is open. *@
        <button type="button" class="index-trigger @(IsCategoryPage ? "active" : "")"
                aria-haspopup="true" aria-expanded="@(open ? "true" : "false")" @onclick="Toggle">
            <span class="index-label">Index</span>
            <svg class="index-chevron" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        @if (open)
        {
            <div class="index-backdrop" @onclick="Close"></div>
            <div class="index-panel">
                <canvas class="index-sand" @ref="sandCanvas"></canvas>
                <div class="index-seam"></div>
                <ul>
                    @* Each drawer carries its own mark. They tint from --cat-color, so the
                       panel is the one place on the site where all ten colors sit together. *@
                    @* The label sits in its own span so the Eyes of Ibad treatment can take
                       the words alone. Left on the whole link, its glow bloomed over the
                       mark beside it and turned a drawer's own color blue. *@
                    <li style="--i: 0" class="category-artifacts"><NavLink href="/category/artifacts"><Mark Name="artifacts" CssClass="index-mark" /><span class="index-label">Artifact</span></NavLink></li>
                    <li style="--i: 1" class="category-disciplines"><NavLink href="/category/disciplines"><Mark Name="disciplines" CssClass="index-mark" /><span class="index-label">Discipline</span></NavLink></li>
                    <li style="--i: 2" class="category-flora-fauna"><NavLink href="/category/flora-fauna"><Mark Name="flora-fauna" CssClass="index-mark" /><span class="index-label">Flora & Fauna</span></NavLink></li>
                    <li style="--i: 3" class="category-historical-events"><NavLink href="/category/historical-events"><Mark Name="historical-events" CssClass="index-mark" /><span class="index-label">Historical Event</span></NavLink></li>
                    <li style="--i: 4" class="category-houses"><NavLink href="/category/houses"><Mark Name="houses" CssClass="index-mark" /><span class="index-label">House</span></NavLink></li>
                    <li style="--i: 5" class="category-organizations"><NavLink href="/category/organizations"><Mark Name="organizations" CssClass="index-mark" /><span class="index-label">Organization</span></NavLink></li>
                    <li style="--i: 6" class="category-personas"><NavLink href="/category/personas"><Mark Name="personas" CssClass="index-mark" /><span class="index-label">Persona</span></NavLink></li>
                    <li style="--i: 7" class="category-theological-systems"><NavLink href="/category/theological-systems"><Mark Name="theological-systems" CssClass="index-mark" /><span class="index-label">Theological System</span></NavLink></li>
                    <li style="--i: 8" class="category-vehicles"><NavLink href="/category/vehicles"><Mark Name="vehicles" CssClass="index-mark" /><span class="index-label">Vehicle</span></NavLink></li>
                    <li style="--i: 9" class="category-worlds"><NavLink href="/category/worlds"><Mark Name="worlds" CssClass="index-mark" /><span class="index-label">World</span></NavLink></li>
                </ul>
            </div>
        }
    </div>
</nav>

@code {
    private bool open;
    private bool runSand;
    private ElementReference sandCanvas;

    // The trigger carries the Eyes of Ibad glow whenever you're inside any category,
    // so the "blue marks where you are" rule survives the links moving into a
    // dropdown.
    private bool IsCategoryPage => Nav.Uri.Contains("/category/");

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (open)
        {
            open = false;
        }
        StateHasChanged();
    }

    private void Toggle()
    {
        open = !open;
        runSand = open;
    }

    private void Close()
    {
        open = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            open = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The canvas only exists when the panel is open, so the sand can only start
        // here, after the render that created it.
        if (open && runSand)
        {
            runSand = false;
            await JS.InvokeVoidAsync("duneNav.sandSettle", sandCanvas);
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
