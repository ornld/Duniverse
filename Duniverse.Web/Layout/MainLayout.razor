@inherits LayoutComponentBase
@inject SpoilerSettings Spoiler

<div class="page">
    <header class="site-header">
        <a href="/" class="site-title">Duniverse</a>
    </header>

    <NavMenu />

    <main class="site-body">
        @* Hold the body until spoiler preferences are read from storage, so a returning reader
           with protection on never sees a flash of hidden content before it is filtered out. *@
        @if (Spoiler.Loaded)
        {
            @Body
        }
    </main>

    <footer class="site-footer">
        <span>An unofficial fan-made encyclopedia of the Dune universe.</span>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Spoiler.LoadAsync();
    }
}
