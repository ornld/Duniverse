@* The two moons of Arrakis, plain pale discs over the horizon. Purely decorative;
   hosts position it and hide it from readers. *@

<svg class="twin-moons @CssClass" width="150" height="92" viewBox="0 0 150 92"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
        <radialGradient id="moon-glow-@uid" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0%" stop-color="rgba(236, 222, 194, 0.16)" />
            <stop offset="70%" stop-color="rgba(236, 222, 194, 0.05)" />
            <stop offset="100%" stop-color="rgba(236, 222, 194, 0)" />
        </radialGradient>
        <radialGradient id="moon-face-@uid" cx="0.36" cy="0.3" r="0.9">
            <stop offset="0%" stop-color="#d9cdb6" />
            <stop offset="100%" stop-color="#a3957b" />
        </radialGradient>
    </defs>

    <circle cx="46" cy="40" r="44" fill="url(#moon-glow-@uid)" />
    <circle cx="114" cy="26" r="27" fill="url(#moon-glow-@uid)" />

    <circle cx="46" cy="40" r="26" fill="url(#moon-face-@uid)" />
    <circle cx="114" cy="26" r="15" fill="url(#moon-face-@uid)" />
</svg>

@code {
    [Parameter] public string? CssClass { get; set; }

    // SVG ids are document-global; the suffix keeps two renders of this component
    // (the footer plus any future sky) from resolving to each other's defs.
    private readonly string uid = Guid.NewGuid().ToString("N")[..8];
}
