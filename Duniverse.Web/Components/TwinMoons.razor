@* The two moons of Arrakis, marked the way the books describe them: the first moon
   carries the pattern of a human hand, the second the kangaroo mouse shadow the
   Fremen named Muad'Dib. Both markings sit at low opacity, found rather than
   announced. Purely decorative; hosts position it and hide it from readers. *@

<svg class="twin-moons @CssClass" width="150" height="92" viewBox="0 0 150 92"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
        <radialGradient id="moon-glow-@uid" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0%" stop-color="rgba(236, 222, 194, 0.16)" />
            <stop offset="70%" stop-color="rgba(236, 222, 194, 0.05)" />
            <stop offset="100%" stop-color="rgba(236, 222, 194, 0)" />
        </radialGradient>
        <radialGradient id="moon-face-@uid" cx="0.36" cy="0.3" r="0.9">
            <stop offset="0%" stop-color="#d9cdb6" />
            <stop offset="100%" stop-color="#a3957b" />
        </radialGradient>
        <clipPath id="moon-first-@uid"><circle cx="46" cy="40" r="26" /></clipPath>
        <clipPath id="moon-second-@uid"><circle cx="114" cy="26" r="15" /></clipPath>
    </defs>

    <circle cx="46" cy="40" r="44" fill="url(#moon-glow-@uid)" />
    <circle cx="114" cy="26" r="27" fill="url(#moon-glow-@uid)" />

    <circle cx="46" cy="40" r="26" fill="url(#moon-face-@uid)" />
    <circle cx="114" cy="26" r="15" fill="url(#moon-face-@uid)" />

    @* The hand: an open palm, fingers spread, drawn as round-capped strokes so the
       digits keep soft edges at this size. *@
    <g clip-path="url(#moon-first-@uid)" opacity="0.18">
        <circle cx="46" cy="45.5" r="6.8" fill="#2e2519" />
        <g stroke="#2e2519" stroke-width="4" stroke-linecap="round">
            <line x1="41" y1="40.5" x2="37.5" y2="29.5" />
            <line x1="45" y1="39.5" x2="44.5" y2="27" />
            <line x1="49" y1="40" x2="50.5" y2="28.5" />
            <line x1="52.5" y1="42" x2="56" y2="33" />
            <line x1="52" y1="49" x2="60" y2="45" />
        </g>
    </g>

    @* Muad'Dib: ears, haunch, long hind foot, tail. A smudge at arm's length,
       a kangaroo mouse when someone leans in. *@
    <g clip-path="url(#moon-second-@uid)" fill="#2e2519" opacity="0.2">
        <ellipse cx="114.5" cy="29" rx="5.2" ry="4.6" />
        <circle cx="110" cy="22.5" r="3.4" />
        <ellipse cx="107" cy="23.5" rx="1.9" ry="1.3" />
        <ellipse cx="109" cy="17.5" rx="1.5" ry="2.8" transform="rotate(-12 109 17.5)" />
        <ellipse cx="112.8" cy="18" rx="1.5" ry="2.8" transform="rotate(14 112.8 18)" />
        <ellipse cx="117" cy="30.5" rx="3.6" ry="4.2" />
        <ellipse cx="114" cy="34.5" rx="3.2" ry="1.2" />
        <path d="M119.5 32 C124 33.5 126 30 125 26.5" fill="none" stroke="#2e2519" stroke-width="1.3" stroke-linecap="round" />
    </g>
</svg>

@code {
    [Parameter] public string? CssClass { get; set; }

    // SVG ids are document-global; the suffix keeps two renders of this component
    // (the footer plus any future sky) from resolving to each other's defs.
    private readonly string uid = Guid.NewGuid().ToString("N")[..8];
}
