@inject SpoilerSettings Spoiler
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LostPageSignal Lost
@implements IDisposable

@* First visit only. The reader marks the last novel they finished and everything past
   it seals. Main menu and About stay exempt, so a newcomer can read about the book in
   peace, and the deep desert too: asking how far someone has read over a page that
   says nothing is here played as farce. Every choice saves, so it asks once. *@

@if (ShouldShow)
{
    <div class="ritual-backdrop @(closing ? "closing" : "")" @onkeydown="HandleKeyDown"
         @onclick="DismissAsync">
        <div class="ritual-panel" role="dialog" aria-modal="true" aria-labelledby="ritual-title"
             tabindex="-1" @ref="panel" @onclick:stopPropagation="true">
            <canvas class="ritual-sand" @ref="sandCanvas"></canvas>

            <h2 id="ritual-title">How deep into the saga have you read?</h2>

            <div class="ritual-shelf">
                @* The numeral prints as I and announces as a letter, so each spine speaks
                   its place plainly instead: the title, then book one of six. *@
                @for (int i = 0; i < Novels.Length; i++)
                {
                    var novel = Novels[i];
                    <button type="button" class="ritual-spine @(chosenTier == novel.Tier ? "is-chosen" : null)" style="--i: @i"
                            aria-label="@($"{novel.Title}, book {i + 1} of 6")"
                            @onclick="() => ChooseAsync(novel.Tier)">
                        <span class="spine-num">@novel.Numeral</span>
                        <span class="spine-title">@novel.Title</span>
                    </button>
                }
            </div>

            <div class="ritual-actions">
                <button type="button" class="surprise-btn" @onclick="OpenEverythingAsync">
                    Open the full archive
                </button>
            </div>

            <p class="ritual-note muted">Change this any time on the Archives page.</p>
        </div>
    </div>
}

@code {
    // Raised after the reader commits a choice, so the layout can re-mount the page
    // underneath and re-filter it against the new progress.
    [Parameter] public EventCallback OnApplied { get; set; }

    // MainLayout seals the page behind this panel. A component cannot reach its own siblings,
    // so the layout owns the sealing and I only tell it when to start and stop.
    [Parameter] public EventCallback<bool> OnOpenChanged { get; set; }

    private bool dismissed;
    private bool closing;
    private bool activated;
    private bool reportedOpen;

    // The book being taken down. Set the moment a spine is clicked, so the pull plays
    // before the panel starts its fade, and so no second choice lands mid-pull.
    private SpoilerTier? chosenTier;
    private ElementReference panel;
    private ElementReference sandCanvas;

    private bool ShouldShow => Spoiler.Loaded && !Spoiler.HasStoredChoice && !dismissed && !OnExemptPage && !Lost.Active;

    // Main menu and About hold no records, so the ritual never covers them. It waits
    // for the first step into the archive proper. I strip query strings and fragments
    // first, so "/?utm=..." still counts as home.
    private bool OnExemptPage
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(new[] { '?', '#' });
            if (cut >= 0)
            {
                relative = relative[..cut];
            }
            relative = relative.TrimEnd('/');
            return relative.Length == 0
                || relative.Equals("about", StringComparison.OrdinalIgnoreCase);
        }
    }

    private record Novel(string Numeral, string Title, SpoilerTier Tier);

    private static readonly Novel[] Novels =
    {
        new("I", "Dune", SpoilerTier.Dune),
        new("II", "Dune Messiah", SpoilerTier.DuneMessiah),
        new("III", "Children of Dune", SpoilerTier.ChildrenOfDune),
        new("IV", "God Emperor", SpoilerTier.GodEmperorOfDune),
        new("V", "Heretics", SpoilerTier.HereticsOfDune),
        new("VI", "Chapterhouse", SpoilerTier.Chapterhouse),
    };

    protected override async Task OnInitializedAsync()
    {
        // Re-check on every route change: that's the moment a fresh reader steps off
        // the main menu and the ritual is due. The desert's signal lands after the
        // route settles, so it gets its own subscription.
        Nav.LocationChanged += OnLocationChanged;
        Lost.Changed += OnLostChanged;

        // I await the storage read here rather than lean on the layout's copy. It's
        // idempotent. A parent re-render skips this component when parameters compare
        // equal, so without the await the ritual stays stuck pre-load and never shows.
        await Spoiler.LoadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void OnLostChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Lost.Changed -= OnLostChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The overlay only exists past the main menu, so I start sand and focus here.
        // Panel focus hands Escape and screen readers the dialog. Browser-back
        // unmounting stops the sand loop, so I skip teardown; activated resets for a
        // replay.
        if (ShouldShow)
        {
            if (!activated)
            {
                activated = true;
                await panel.FocusAsync();
                await JS.InvokeVoidAsync("duneNav.sandSettle", sandCanvas);
            }
        }
        else
        {
            activated = false;
            chosenTier = null;
        }

        if (reportedOpen == ShouldShow)
        {
            return;
        }

        // I report from here since ShouldShow turns on a route change and a storage read, not
        // only on a choice. Moving focus afterwards belongs to the layout, which knows when
        // its own seal comes off.
        reportedOpen = ShouldShow;
        await OnOpenChanged.InvokeAsync(reportedOpen);
    }

    private async Task ChooseAsync(SpoilerTier tier)
    {
        if (closing || chosenTier is not null)
        {
            return;
        }

        // The pull is the acknowledgment: the chosen book comes off the shelf first,
        // and only then does the panel begin its fade. The delay matches the CSS.
        chosenTier = tier;
        StateHasChanged();
        await Task.Delay(280);

        await Spoiler.UpdateAsync(enabled: true, tier, includeExpandedUniverse: false);
        await CloseAsync(applied: true);
    }

    private async Task OpenEverythingAsync()
    {
        if (closing || chosenTier is not null)
        {
            return;
        }

        await Spoiler.UpdateAsync(enabled: false, Spoiler.NovelProgress, Spoiler.IncludeExpandedUniverse);
        await CloseAsync(applied: true);
    }

    // Skipping keeps the safe default (guarded at Dune) and records it as a real
    // choice, so the ritual only asks once. The page underneath already rendered with
    // these defaults, so nothing needs to re-filter.
    private async Task SkipAsync()
    {
        // A tap on the surround while a chosen book is mid-pull is not a skip.
        if (closing || chosenTier is not null)
        {
            return;
        }

        await Spoiler.UpdateAsync(Spoiler.Enabled, Spoiler.NovelProgress, Spoiler.IncludeExpandedUniverse);
        await CloseAsync(applied: false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !closing)
        {
            await SkipAsync();
        }
    }

    // Escape has always been the quiet way out, and a phone has no Escape key. A tap on the
    // dark surround does the same job. The panel stops its own clicks here, and I am not
    // putting the skip button back to solve this.
    private async Task DismissAsync()
    {
        if (!closing)
        {
            await SkipAsync();
        }
    }

    private async Task CloseAsync(bool applied)
    {
        // A short fade out instead of a hard vanish; the delay matches the CSS.
        closing = true;
        StateHasChanged();
        await Task.Delay(300);
        dismissed = true;

        if (applied)
        {
            await OnApplied.InvokeAsync();
        }
    }
}
