@inject SpoilerSettings Spoiler

@*
    How much archive is still shut, said out loud.

    Spoiler protection has always worked as pure absence: records the reader has not reached
    simply are not there, and nothing tells them the shelf is short. This gives the absence a
    number, the way an Imperial archive would admit that a drawer holds sealed records without
    admitting what is in them.

    It never names anything. Only a count, the next book that opens some of it, and, when it
    applies, how much sits outside the six novels entirely.

    Deliberately kept to whole categories and to the archive as a whole. The same line under a
    small roster would be an invitation to guess: "one member of this House remains sealed"
    narrows to a handful of people and hands over the fact that one of them matters later.
*@

@if (sealedCount > 0)
{
    @* A status region so the count reaches a screen reader when the reader moves their
       progress and the number changes under them. *@
    @* The spaces before each clause are written out. Razor eats the whitespace sitting between
       a closing brace and the next block, so without them the sentences run together. *@
    <p class="imperial-seal" role="status" aria-live="polite">
        @sealedCount @(sealedCount == 1 ? "record" : "records") @Scope
        @(sealedCount == 1 ? "remains" : "remain") under seal.
        @if (nextBook is not null)
        {
            @(" ")<span>@nextBook opens the next.</span>
        }
        @if (expandedOnly > 0)
        {
            @(" ")<span>@expandedOnly of @(sealedCount == expandedOnly ? "those" : "them")
                @(expandedOnly == 1 ? "sits" : "sit") outside the six novels.</span>
        }
    </p>
}

@code {
    /// <summary>Every record this scope covers, before any spoiler filtering.</summary>
    [Parameter]
    public IEnumerable<DuneEntity> All { get; set; } = Array.Empty<DuneEntity>();

    /// <summary>Reads into the sentence after the count, e.g. "in this category".</summary>
    [Parameter]
    public string Scope { get; set; } = "in the archive";

    private int sealedCount;
    private int expandedOnly;
    private string? nextBook;

    protected override void OnParametersSet()
    {
        var hidden = All.Where(e => !Spoiler.IsVisible(e)).ToList();
        sealedCount = hidden.Count;

        // Counted separately because reading on will never open them. Lumping them into a total
        // whose only follow-up names the next novel would promise more than finishing the saga
        // delivers, and leave a reader who did finish it wondering what they got wrong.
        expandedOnly = hidden.Count(e => e.SpoilerTier == SpoilerTier.ExpandedUniverse);

        // The nearest novel along the spine that would actually open something.
        nextBook = hidden
            .Select(e => e.SpoilerTier)
            .Where(t => t != SpoilerTier.ExpandedUniverse)
            .OrderBy(t => t)
            .Select(BookName)
            .FirstOrDefault();
    }

    private static string BookName(SpoilerTier tier) => tier switch
    {
        SpoilerTier.DuneMessiah => "Dune Messiah",
        SpoilerTier.ChildrenOfDune => "Children of Dune",
        SpoilerTier.GodEmperorOfDune => "God Emperor of Dune",
        SpoilerTier.HereticsOfDune => "Heretics of Dune",
        SpoilerTier.Chapterhouse => "Chapterhouse: Dune",
        _ => "Dune",
    };
}
