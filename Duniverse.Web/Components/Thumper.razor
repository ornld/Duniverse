@* The rings and the wormsign crossing draw here, over the whole horizon band, sized by
   the script when the thumper is planted. Pointer events off. *@
<canvas class="thumper-stage" @ref="stage" aria-hidden="true"></canvas>

@code {
    private ElementReference thumper;
    private ElementReference stage;
    private bool planted;
    private bool gone;

    public void Dispose()
    {
        gone = true;
    }

    // Planting is a ceremony the script runs: three slams, the rings, the crossing. It
    // answers true once the worm has crossed, and then I walk the page to the deep desert.
    private async Task PlantThumper()
    {
        if (planted)
        {
            return;
        }
        planted = true;

        bool called;
        try
        {
            called = await JS.InvokeAsync<bool>("duneNav.thumperCall", thumper, stage);
        }
        catch
        {
            called = false;
        }

        if (called && !gone)
        {
            Nav.NavigateTo("/deep-desert");
        }
    }
}
