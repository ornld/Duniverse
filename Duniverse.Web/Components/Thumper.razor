@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@* The door to the deep desert: a thumper no taller than the small moon, planted on the
   near crest beneath it on every page. A real button, so a keyboard can plant it too.
   Press it and the clapper pounds, the sand rings, and the worm carries the page away. *@
<button type="button" class="thumper @(planted ? "is-thumping" : "")" title="Thumper"
        aria-label="Plant the thumper" disabled="@planted" @ref="thumper" @onclick="PlantThumper">
