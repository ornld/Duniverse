        <ellipse cx="50" cy="235" rx="14" ry="3" fill="rgba(0, 0, 0, 0.45)" />

        <path d="M45 178 H55 L51 236 H49 Z" fill="#141110" />
        <path d="M50 178 H55 L51 236 H50 Z" fill="#221d19" />

