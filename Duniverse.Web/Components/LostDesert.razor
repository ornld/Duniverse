        </svg>
    </button>

    @* The rings and the wormsign crossing draw here, last in DOM order so they paint above
       everything, sized by the script when the thumper is planted. Pointer events off. *@
    <canvas class="lost-thumper" @ref="ceremonyCanvas" aria-hidden="true"></canvas>
</div>

@code {
    private ElementReference hero;
    private ElementReference thumper;
    private ElementReference ceremonyCanvas;
    private bool planted;
    private bool gone;

    // Standing in the sand is announced, not inferred: the catch-all route means a
    // lost page can wear any address, so the ritual asks this signal instead of the URL.
    protected override void OnInitialized()
    {
        Lost.Set(true);
    }

    public void Dispose()
    {
        gone = true;
        Lost.Set(false);
    }

    /// <summary>
    /// The line over the sand. Both callers say the same thing so far, which is the point:
    /// a reader who hits one dead end and then the other should recognise the place.
    /// </summary>
    [Parameter]
    public string Heading { get; set; } = "Lost in the deep desert";

    /// <summary>
    /// The sentences under the heading. This is where the two callers differ, since one
    /// knows the bad address and the other knows the bad record id.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    // Planting is a ceremony the script runs: three slams, the rings, the crossing. It
    // answers true once the worm has crossed, and then I walk the page to the deep desert.
    private async Task PlantThumper()
    {
        if (planted)
        {
            return;
        }
        planted = true;

        bool called;
        try
        {
            called = await JS.InvokeAsync<bool>("duneNav.thumperCall", hero, thumper, ceremonyCanvas);
        }
        catch
        {
            called = false;
        }

        if (called && !gone)
        {
            Nav.NavigateTo("/deep-desert");
        }
    }

    // A guide out of the erg: any record the reader is cleared to see.
    private void FollowGuide()
    {
        var entity = Registry.GetRandomEntity(Spoiler.IsVisible);
        if (entity is not null)
        {
            Nav.NavigateTo($"/entity/{entity.Id}");
        }
    }
}
