            <ellipse cx="50" cy="234" rx="34" ry="7" fill="rgba(224, 164, 88, 0.10)" />
            <ellipse cx="50" cy="235" rx="14" ry="3" fill="rgba(0, 0, 0, 0.45)" />

            <path d="M45 178 H55 L51 236 H49 Z" fill="#141110" />
            <path d="M50 178 H55 L51 236 H50 Z" fill="#221d19" />

            <rect x="37" y="150" width="26" height="30" rx="2" fill="#1a1613" />
            <rect x="37" y="155" width="26" height="2" fill="#0a0908" />
            <rect x="37" y="157" width="26" height="1" fill="#332b25" />
            <rect x="37" y="161" width="26" height="2" fill="#0a0908" />
            <rect x="37" y="163" width="26" height="1" fill="#332b25" />
            <rect x="37" y="167" width="26" height="2" fill="#0a0908" />
            <rect x="37" y="169" width="26" height="1" fill="#332b25" />
            <rect x="37" y="173" width="26" height="2" fill="#0a0908" />
            <rect x="37" y="175" width="26" height="1" fill="#332b25" />

            <rect x="28" y="132" width="44" height="18" rx="3" fill="#201b17" stroke="#3b322a" stroke-width="1" />
            <rect x="32" y="136" width="3" height="10" fill="#0a0908" />
            <rect x="35" y="136" width="1" height="10" fill="#3b322a" />
            <rect x="38" y="136" width="3" height="10" fill="#0a0908" />
            <rect x="41" y="136" width="1" height="10" fill="#3b322a" />
            <rect x="44" y="136" width="3" height="10" fill="#0a0908" />
            <rect x="47" y="136" width="1" height="10" fill="#3b322a" />
            <rect x="50" y="136" width="3" height="10" fill="#0a0908" />
            <rect x="53" y="136" width="1" height="10" fill="#3b322a" />
            <rect x="56" y="136" width="3" height="10" fill="#0a0908" />
            <rect x="59" y="136" width="1" height="10" fill="#3b322a" />
            <rect x="62" y="136" width="3" height="10" fill="#0a0908" />
            <rect x="65" y="136" width="1" height="10" fill="#3b322a" />

            <rect x="26" y="30" width="48" height="104" rx="7" fill="#1c1815" />
            <rect x="30" y="34" width="6" height="96" rx="3" fill="rgba(255, 255, 255, 0.05)" />
            <rect x="64" y="34" width="8" height="96" rx="3" fill="rgba(0, 0, 0, 0.35)" />
            <rect x="32" y="44" width="5" height="66" rx="2.5" fill="#070605" />
            <rect x="32" y="46" width="1" height="62" fill="rgba(255, 255, 255, 0.06)" />
            <rect x="41" y="44" width="6" height="66" rx="3" fill="#070605" />
