@inject EntityRegistry Registry
@inject SpoilerSettings Spoiler
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LostPageSignal Lost
@implements IDisposable

@* Open sand for a URL with no page or an id with no record. The night sky and its stars
   come from the CSS alone; the blowing sand used to run here too and it did not belong. *@
<div class="hero lost-desert" @ref="hero">
    <h1>@Heading</h1>
    <p class="tagline">@ChildContent</p>
    <div class="lost-actions">
        <a class="chip" href="/archives">Search the Archives</a>
        <a class="chip" href="/">Return home</a>
        <button class="surprise-btn" @onclick="FollowGuide">Follow a Fremen guide</button>
    </div>

    @* The door to the deep desert: a thumper planted in the sand. A real button, so a
       keyboard can plant it too. Press it and the clapper pounds, the sand rings, and the
       worm comes to carry the page away. *@
    <button type="button" class="thumper @(planted ? "is-thumping" : "")" title="Thumper"
            aria-label="Plant the thumper" disabled="@planted" @ref="thumper" @onclick="PlantThumper">
