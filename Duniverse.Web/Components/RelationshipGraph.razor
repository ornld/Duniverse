@inject EntityRegistry Registry
@inject GraphLayoutService LayoutService
@inject GraphLayoutCache LayoutCache
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler

@if (graph is not null && graph.Nodes.Count > 1)
{
    <div class="graph-wrapper">
        @* I describe this as one picture, not a web of controls. Everything drawn here is
           listed in Related below as plain links a keyboard and screen reader already
           handle, so naming every node twice would only lengthen the page. *@
        <svg class="relationship-graph @(hoveredNodeId is null ? null : "has-hover")" viewBox="0 0 @Width @Height" preserveAspectRatio="xMidYMid meet"
             role="img" aria-label="@($"A web of {graph.Nodes.Count - 1} records connected to this one. Each is listed with its relationship below.")">
            <g class="graph-edges">
                @foreach (var edge in graph.Edges)
                {
                    var source = nodesById[edge.SourceId];
                    var target = nodesById[edge.TargetId];
                    var tip = EdgeTip(edge);
                    <line x1="@source.X.ToString(Inv)" y1="@source.Y.ToString(Inv)"
                          x2="@target.X.ToString(Inv)" y2="@target.Y.ToString(Inv)"
                          class="@EdgeClasses(edge, tip)">
                        @if (tip is not null)
                        {
                            <title>@tip</title>
                        }
                    </line>
                }
            </g>
            <g class="graph-nodes">
                @foreach (var node in graph.Nodes)
                {
                    <g class="graph-node category-@node.Category @(node.IsCenter ? "is-center" : "") @(IsNearHovered(node) ? "near-hovered" : "") @(IsActive(node) ? "is-active" : null)"
                       transform="translate(@node.X.ToString(Inv), @node.Y.ToString(Inv))"
                       @onpointerdown="e => RememberPointer(e)"
                       @onclick="() => Activate(node.Id)"
                       @onmouseover="() => hoveredNodeId = node.Id"
                       @onmouseout="() => OnMouseOut()">
                        <circle r="@(node.IsCenter ? 20 : 11)" />
                        <text y="@(node.IsCenter ? 34 : 24)">@Truncate(node.Name)</text>
                        <title>@NodeTip(node)</title>
                    </g>
                }
            </g>
        </svg>
        @* The old line said "hover", which is advice a touchscreen cannot take. *@
        <p class="graph-hint muted">Hover any node to light its connections. Click it to re-center the web on it.</p>
        <p class="graph-hint muted graph-hint-touch">Tap a node to name it and light its connections. Tap it again to open its record.</p>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired]
    public string CenterId { get; set; } = "";

    private const double Width = 760;
    private const double Height = 460;

    private EntityGraph? graph;
    private Dictionary<string, GraphNode> nodesById = new();
    private Dictionary<string, HashSet<string>> neighborsById = new(StringComparer.OrdinalIgnoreCase);
    private string? hoveredNodeId;

    // Runs on every parameter change, so a web used to settle again on each return. The
    // sim is deterministic and the cache keys on the records, so a reader who has opened
    // this record already gets the picture they left.
    protected override void OnParametersSet()
    {
        var fresh = LayoutService.BuildEgoGraph(Registry, CenterId, maxDepth: 2, include: Spoiler.IsVisible,
            linkVisible: Spoiler.IsVisible);
        graph = LayoutCache.GetOrAdd(
            GraphLayoutCache.KeyFor($"ego:{CenterId}:{Width}x{Height}", fresh),
            fresh,
            g => LayoutService.ApplyForceDirectedLayout(g, Width, Height));
        nodesById = graph.Nodes.ToDictionary(n => n.Id, StringComparer.OrdinalIgnoreCase);
        neighborsById = BuildNeighbors(graph);
        hoveredNodeId = null;
    }

    private static Dictionary<string, HashSet<string>> BuildNeighbors(EntityGraph graph)
    {
        var map = graph.Nodes.ToDictionary(
            n => n.Id,
            _ => new HashSet<string>(StringComparer.OrdinalIgnoreCase),
            StringComparer.OrdinalIgnoreCase);
        foreach (var edge in graph.Edges)
        {
            map[edge.SourceId].Add(edge.TargetId);
            map[edge.TargetId].Add(edge.SourceId);
        }
        return map;
    }

    // The hovered node and its direct neighbors keep full presence as the rest of the
    // graph fades back. A node counts as near itself so it never fades under the cursor.
    private bool IsNearHovered(GraphNode node)
    {
        return hoveredNodeId is not null
            && (string.Equals(node.Id, hoveredNodeId, StringComparison.OrdinalIgnoreCase)
                || (neighborsById.TryGetValue(hoveredNodeId, out var near) && near.Contains(node.Id)));
    }

    // The one node singled out right now, as against the neighbourhood lit around it.
    private bool IsActive(GraphNode node)
        => string.Equals(node.Id, hoveredNodeId, StringComparison.OrdinalIgnoreCase);

    // Which kind of pointer opened the current interaction. A touchscreen never hovers, so
    // a press has to do the naming that a cursor does by arriving.
    private bool lastPointerWasTouch;

    // The node a finger has already named. Held apart from hoveredNodeId, which a passing
    // mouse also sets: a cursor must never leave a node primed to open on the next press.
    private string? revealedByTouch;

    private void RememberPointer(PointerEventArgs e)
    {
        lastPointerWasTouch = e.PointerType is "touch" or "pen";
    }

    // A cursor leaving a node drops the highlight. A finger's stays: there is nowhere for
    // touch to move away to, and the name has to outlast the press to be read at all.
    private void OnMouseOut()
    {
        if (!lastPointerWasTouch)
        {
            hoveredNodeId = null;
        }
    }

    // Mouse keeps one click. Touch takes two: the first names the node and lights its web,
    // the second opens it. Showing every name at once dies on a phone, where the web scales
    // under half and labels stack.
    private void Activate(string id)
    {
        if (lastPointerWasTouch && !string.Equals(revealedByTouch, id, StringComparison.OrdinalIgnoreCase))
        {
            revealedByTouch = id;
            hoveredNodeId = id;
            return;
        }

        GoTo(id);
    }

    private void GoTo(string id)
    {
        Nav.NavigateTo($"/entity/{id}");
    }

    private static string Truncate(string name) => name.Length > 18 ? name[..17] + "…" : name;

    // Edges highlight two ways on hover: has-label marks pairs whose relationship has a
    // tooltip, and touches-hovered lights every line into the node under the cursor,
    // labeled or not, so you can read a node's whole web at a glance.
    private string? EdgeClasses(GraphEdge edge, string? tip)
    {
        var touchesHovered = hoveredNodeId is not null
            && (string.Equals(edge.SourceId, hoveredNodeId, StringComparison.OrdinalIgnoreCase)
                || string.Equals(edge.TargetId, hoveredNodeId, StringComparison.OrdinalIgnoreCase));

        return (tip, touchesHovered) switch
        {
            (null, false) => null,
            (null, true) => "touches-hovered",
            (_, false) => "has-label",
            (_, true) => "has-label touches-hovered"
        };
    }

    // The spoiler-checked role phrase for what otherId is to viewedId, or null.
    private string? VisibleRole(string viewedId, string otherId)
    {
        return Registry.GetRelationshipLabel(viewedId, otherId) is { } label && Spoiler.IsVisible(label.Tier)
            ? label.Role
            : null;
    }

    // Hover text for an edge: both sides of the relationship when the pair has one.
    // "Lady Jessica: Mother / Paul Atreides: Son", collapsed to a single phrase when
    // the label reads the same from both ends (rivals, twins, fellow conspirators).
    private string? EdgeTip(GraphEdge edge)
    {
        var roleOfTarget = VisibleRole(edge.SourceId, edge.TargetId);
        var roleOfSource = VisibleRole(edge.TargetId, edge.SourceId);
        if (roleOfSource is null || roleOfTarget is null)
        {
            return null;
        }

        var source = nodesById[edge.SourceId];
        var target = nodesById[edge.TargetId];

        return roleOfSource == roleOfTarget
            ? $"{source.Name} & {target.Name}: {roleOfSource}"
            : $"{source.Name}: {roleOfSource} / {target.Name}: {roleOfTarget}";
    }

    // Hover text for a node: its role relative to the graph's center, when one is
    // recorded, folded into the name-and-description tooltip it already has.
    private string NodeTip(GraphNode node)
    {
        var role = node.IsCenter ? null : VisibleRole(CenterId, node.Id);
        return role is null
            ? $"{node.Name}: {node.ShortDescription}"
            : $"{node.Name} ({role}): {node.ShortDescription}";
    }
}
