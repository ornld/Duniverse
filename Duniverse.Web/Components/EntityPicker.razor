@inject EntityRegistry Registry
@inject SpoilerSettings Spoiler

@* One end of a connection trace. Type to narrow, pick, and the record becomes a chip
   you can clear back to the input. I run suggestions through the spoiler gate, so
   nobody anchors on a record they haven't unlocked. *@

<div class="endpoint-picker">
    <span class="endpoint-label">@Label</span>

    @if (Selected is not null)
    {
        <div class="endpoint-chosen connection-cat category-@GraphLayoutService.CategorySlug(Selected)">
            <span class="endpoint-dot"></span>
            <span class="endpoint-name" title="@Selected.ShortDescription">@Selected.Name</span>
            <button type="button" class="endpoint-clear" title="Clear this record" @onclick="ClearAsync">&times;</button>
        </div>
    }
    else
    {
        @* The label above is a plain span, so nothing tied it to this box. Reusing its text
           names the input on every page that mounts a picker. *@
        <input @bind="query" @bind:event="oninput" @bind:after="UpdateSuggestions"
               @onkeyup="HandleKeyUp" aria-label="@Label" placeholder="@Placeholder" />

        @if (suggestions.Count > 0)
        {
            <ul class="endpoint-suggestions">
                @foreach (var suggestion in suggestions)
                {
                    <li>
                        <button type="button" @onclick="() => PickAsync(suggestion)">
                            <span class="endpoint-dot connection-cat category-@GraphLayoutService.CategorySlug(suggestion)"></span>
                            <span>@suggestion.Name</span>
                            @if (ShowDescriptions)
                            {
                                <span class="muted">@suggestion.ShortDescription</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        }
        else if (nothingAnswered)
        {
            @* Enter on a name the archive cannot resolve used to pass in silence. The line
               is deliberately the same whether a record is misspelled, missing, or sealed
               past the reader's progress: confirming a seal is itself a leak. *@
            <p class="endpoint-empty muted" role="status">The archive holds no record by that name.</p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string Placeholder { get; set; } = "";

    @* The Mentat Trial turns these off. Its opening clue is the answer's own description
       with the name blacked out, so suggestions that print descriptions would let a
       player check candidates against the clue without spending a guess. *@
    [Parameter]
    public bool ShowDescriptions { get; set; } = true;

    [Parameter]
    public DuneEntity? Selected { get; set; }

    [Parameter]
    public EventCallback<DuneEntity?> SelectedChanged { get; set; }

    private string query = "";
    private List<DuneEntity> suggestions = new();
    private bool nothingAnswered;

    private void UpdateSuggestions()
    {
        nothingAnswered = false;
        var trimmed = query.Trim();

        // A single letter matches half the archive, so wait for two before suggesting.
        if (trimmed.Length < 2)
        {
            suggestions.Clear();
            return;
        }

        // Shortest names first: for a query like "atreides" that puts "House Atreides"
        // ahead of the longer compound names, which is usually what was meant.
        suggestions = Registry.SearchByName(trimmed)
            .Where(Spoiler.IsVisible)
            .OrderBy(entity => entity.Name.Length)
            .ThenBy(entity => entity.Name)
            .Take(8)
            .ToList();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        // Enter takes the archive's best read of the text (exact ID, unique name, or
        // typo fix), and otherwise falls back to the top suggestion. A name that
        // resolves to nothing gets said so; an empty box asked no question.
        var trimmed = query.Trim();
        var resolved = Registry.Resolve(trimmed).Entity;
        if (resolved is not null && Spoiler.IsVisible(resolved))
        {
            await PickAsync(resolved);
        }
        else if (suggestions.Count > 0)
        {
            await PickAsync(suggestions[0]);
        }
        else if (trimmed.Length > 0)
        {
            nothingAnswered = true;
        }
    }

    private async Task PickAsync(DuneEntity entity)
    {
        query = "";
        suggestions.Clear();
        nothingAnswered = false;
        Selected = entity;
        await SelectedChanged.InvokeAsync(entity);
    }

    private async Task ClearAsync()
    {
        Selected = null;
        await SelectedChanged.InvokeAsync(null);
    }
}
