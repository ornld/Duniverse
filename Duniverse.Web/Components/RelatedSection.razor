@if (Items is not null && Items.Any())
{
    <div class="related-section">
        <h3>@Title</h3>
        <ul>
            @foreach (var item in Items)
            {
                <li>
                    <a href="@($"/entity/{item.Id}")">@item.Name</a>@if (RoleFor?.Invoke(item.Id) is string role)
                    {<span class="related-role">@role</span>}: <span class="muted">@item.ShortDescription</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public IEnumerable<DuneEntity>? Items { get; set; }

    /// <summary>
    /// Optional lookup mapping a related entity's id to what it is to the entity being
    /// viewed ("Mother", "Betrayer of his House"). Null means no badge. The caller owns
    /// spoiler filtering, so this component never checks reading progress.
    /// </summary>
    [Parameter]
    public Func<string, string?>? RoleFor { get; set; }
}
