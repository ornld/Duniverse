@page "/"
@inject EntityRegistry Registry
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler

<PageTitle>Duniverse</PageTitle>

<div class="hero" style="background-image: var(--scrim-soft), url('/images/main-menu-background.webp');">
    <h1>Welcome to the Duniverse</h1>
    <p class="tagline">
        An unofficial encyclopedia of Frank Herbert's Dune Saga.
    </p>

    <div class="home-search">
        <EntityPicker Label="Find a record" Placeholder="Ask the archive: Paul Atreides, Arrakis, the Bene Gesserit..."
                      SelectedChanged="OpenRecord" />
    </div>
    <p class="cta">
        <button class="surprise-btn" @onclick="RandomJump">Let the archive choose</button>
    </p>

    @if (dailySaying is not null)
    {
        <blockquote class="epigraph daily-saying">
            <p class="epigraph-text">@dailySaying.Text</p>
            <footer class="epigraph-source">from @dailySaying.Work &middot; <a href="/sayings">more sayings</a></footer>
        </blockquote>
    }

    <section class="home-section home-doors">
        <h2>Ways into the archive</h2>
        <div class="category-grid">
            @* Each door wears its destination's running head as an eyebrow, off the same
               table the site header reads, so the doors read as labeled drawers of one
               volume instead of nine matching boxes. *@
            <a class="category-tile" href="/about">
                <span class="door-register">@MainLayout.RegisterFor("/about")</span>
                <strong>About Dune</strong>
                <span class="muted">Read about the novel, the man who wrote it, and why it matters.</span>
            </a>
            <a class="category-tile" href="/archives">
                <span class="door-register">@MainLayout.RegisterFor("/archives")</span>
                <strong>Archives</strong>
                <span class="muted">Search for anyone or anything in the Dune universe.</span>
            </a>
            <a class="category-tile" href="/timeline">
                <span class="door-register">@MainLayout.RegisterFor("/timeline")</span>
                <strong>Timeline</strong>
                <span class="muted">See all of the major events of the saga in order.</span>
            </a>
            <a class="category-tile" href="/bloodlines">
                <span class="door-register">@MainLayout.RegisterFor("/bloodlines")</span>
                <strong>Bloodlines</strong>
                <span class="muted">Trace the bloodlines the Bene Gesserit spent ninety generations breeding.</span>
            </a>
            <a class="category-tile" href="/connections">
                <span class="door-register">@MainLayout.RegisterFor("/connections")</span>
                <strong>Connections</strong>
                <span class="muted">Choose two records and the archive will trace the chain that joins them.</span>
            </a>
            <a class="category-tile" href="/universe">
                <span class="door-register">@MainLayout.RegisterFor("/universe")</span>
                <strong>Universe</strong>
                <span class="muted">See every record and every connection between them, drawn as one web.</span>
            </a>
            <a class="category-tile" href="/terminology">
                <span class="door-register">@MainLayout.RegisterFor("/terminology")</span>
                <strong>Terminology</strong>
                <span class="muted">Look up any term in a field dictionary of the Dune universe.</span>
            </a>
            <a class="category-tile" href="/sayings">
                <span class="door-register">@MainLayout.RegisterFor("/sayings")</span>
                <strong>Sayings</strong>
                <span class="muted">Read the chapter introductions, in the order Frank Herbert wrote them.</span>
            </a>
            <a class="category-tile" href="/trial">
                <span class="door-register">@MainLayout.RegisterFor("/trial")</span>
                <strong>Mentat Trial</strong>
                <span class="muted">Name the day's sealed record in six guesses, one clue at a time.</span>
            </a>
        </div>
    </section>
</div>

@code {
    private Epigraph? dailySaying;

    protected override void OnInitialized()
    {
        // One saying per day, picked by date instead of chance, so everyone visiting
        // on the same day sees the same line. Only spoiler-safe sayings enter the
        // rotation, and only ones that read at a glance: the chapter headings brought
        // page-long entries, and the cap sits high enough to keep the Litany in.
        var pool = EpigraphSeeder.GetEpigraphs()
            .Where(epigraph => Spoiler.IsVisible(epigraph.Tier) && epigraph.Text.Length <= 420)
            .ToList();

        if (pool.Count > 0)
        {
            dailySaying = pool[DateTime.Now.DayOfYear % pool.Count];
        }
    }

    private void OpenRecord(DuneEntity? entity)
    {
        if (entity is not null)
        {
            Nav.NavigateTo($"/entity/{entity.Id}");
        }
    }

    private void RandomJump()
    {
        var entity = Registry.GetRandomEntity(Spoiler.IsVisible);
        if (entity is not null)
        {
            Nav.NavigateTo($"/entity/{entity.Id}");
        }
    }
}
