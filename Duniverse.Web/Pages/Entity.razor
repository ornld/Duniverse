@page "/entity/{Id}"
@inject EntityRegistry Registry
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler

<PageTitle>@((entity is not null && isGated && !revealed) ? "Spoiler-protected entry" : (entity?.Name ?? "Not Found")) - Duniverse</PageTitle>

<a class="back-link" href="@BackHref">&larr; @BackLabel</a>

@if (entity is not null && isGated && !revealed)
{
    <div class="entity-card front spoiler-gate dossier-item category-@GraphLayoutService.CategorySlug(entity)" style="--i: 0" @key="entity.Id">
        <h1>A spoiler lies ahead</h1>
        <p class="short-desc">This entry draws on @BookName(entity.SpoilerTier).</p>
        <p>
            Your reading progress is set to stop short of that. You can reveal this entry
            anyway, adjust your progress on the Archives page, or head back and keep exploring
            what's safe for you.
        </p>
        <div class="gate-actions">
            <button class="surprise-btn" @onclick="Reveal">Reveal this entry</button>
            <a class="chip" href="/archives">Back to search</a>
        </div>
    </div>
}
else if (entity is not null)
{
    @* One keyed wrapper per record: navigating from one entity to another rebuilds this
       subtree, so the dossier entrance below replays for every newly opened record. *@
    <div @key="entity.Id">
    <div class="entity-card front dossier-item category-@GraphLayoutService.CategorySlug(entity)" style="--i: 0">
        <h1>@entity.Name</h1>
        <p class="short-desc">@entity.ShortDescription</p>

        @* The record's own field data, whatever kind of record it is. Every category keeps its
           facts in different fields; MetaRowsFor turns each into the same labeled rows, so a
           world's environment and a house's motto read as one archive rather than nine formats. *@
        @if (MetaRowsFor(entity) is { Count: > 0 } metaRows)
        {
            <dl class="entity-meta">
                @foreach (var row in metaRows)
                {
                    <div class="meta-row">
                        <dt>@row.Label</dt>
                        <dd>
                            @if (row.Items is not null)
                            {
                                <ul class="meta-list">
                                    @foreach (var item in row.Items)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                @row.Value
                            }
                        </dd>
                    </div>
                }
            </dl>
        }

        @if (!string.IsNullOrEmpty(entity.DetailedHistory))
        {
            <p class="detailed-history">@entity.DetailedHistory</p>
        }

        @if (entity is Persona quotedPersona && quotedPersona.NotableQuotes.Count > 0)
        {
            <div class="entity-quotes">
                @foreach (var quote in quotedPersona.NotableQuotes)
                {
                    <blockquote class="entity-quote">"@quote"</blockquote>
                }
            </div>
        }

        @if (entity is House && rivals.Count > 0)
        {
            <p class="rivalries">
                <strong>Historical Rivalries:</strong> @string.Join(", ", rivals.Select(rival => rival.Name))
            </p>
        }
    </div>

    @* Who belongs to this house or order, gathered from the affiliation each person's own
       record already declares. Sits beside the house's description rather than down among
       the connections, because membership is part of what the house IS, not a link out. *@
    @if (members.Count > 0)
    {
        <div class="entity-card roster-card dossier-item" style="--i: 1">
            <RelatedSection Title="Known Members" Items="members" />
        </div>
    }

    <div class="connections-divider dossier-item" style="--i: 2">
        <span>Connected relationships throughout the Duniverse</span>
    </div>

    @if (hasAnyConnections)
    {
        <div class="entity-card graph-card dossier-item" style="--i: 3">
            <RelationshipGraph CenterId="@entity.Id" />
        </div>
    }

    @* Doors out of the record and into the site's larger tools, each already aimed at
       this entity. Bloodlines only appears for people who actually stand in the chart. *@
    <nav class="entity-explore dossier-item" style="--i: 4" aria-label="Explore this record further">
        <a class="explore-link" href="@($"/connections?from={entity.Id}")">
            <span class="explore-glyph" aria-hidden="true">&#8596;</span>Trace a connection from here
        </a>
        <a class="explore-link" href="@($"/universe?focus={entity.Id}")">
            <span class="explore-glyph" aria-hidden="true">&#9673;</span>See it in the whole Duniverse
        </a>
        @if (InBloodline)
        {
            <a class="explore-link" href="@($"/bloodlines?focus={entity.Id}")">
                <span class="explore-glyph" aria-hidden="true">&#9906;</span>View in the bloodlines
            </a>
        }
    </nav>

    <div class="entity-card back dossier-item" style="--i: 5">
        @foreach (var group in Sections)
        {
            <RelatedSection Title="@group.Title" Items="related.Where(group.Matches)" RoleFor="RoleFor" />
        }

        @if (!hasAnyConnections)
        {
            <p class="muted">No connected records found.</p>
        }
    </div>
    </div>
}
else if (candidates.Count > 0)
{
    <div class="entity-card front">
        <h2>@candidates.Count records match "@Id"</h2>
        <p>Did you mean:</p>
        <ul>
            @foreach (var candidate in candidates)
            {
                <li>
                    <a href="@($"/entity/{candidate.Id}")">@candidate.Name</a>
                    <span class="muted">@candidate.ShortDescription</span>
                </li>
            }
        </ul>
    </div>
}
else
{
    <div class="entity-card front">
        <h2>No record found for "@Id"</h2>
        <p>Verify the ID or name and try again.</p>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private DuneEntity? entity;
    private bool isGated;
    private bool revealed;

    // A resolved record sends "back" to its own category page, so paging Index -> category
    // -> record returns the reader where they started. Unresolved states (a typo with
    // several matches, or nothing found) have no single category, so they keep the Archives
    // fallback.
    private string BackHref =>
        entity is not null && GraphLayoutService.CategorySlug(entity) is var slug and not "unknown"
            ? $"/category/{slug}"
            : "/archives";

    private string BackLabel =>
        entity is not null && GraphLayoutService.CategorySlug(entity) != "unknown"
            ? $"Back to {GraphLayoutService.CategoryTitle(entity)}"
            : "Back to Archives";

    // True only when this record actually stands in the Bloodlines chart at the reader's
    // progress, so the "View in the bloodlines" door never points at a chart without them.
    private bool InBloodline =>
        entity is not null
        && BloodlineMap.Nodes.FirstOrDefault(n =>
            string.Equals(n.EntityId, entity.Id, StringComparison.OrdinalIgnoreCase)) is { } node
        && Spoiler.IsVisible(node.Tier);
    private List<House> rivals = new();
    private List<DuneEntity> members = new();
    private List<DuneEntity> candidates = new();
    private List<DuneEntity> related = new();
    private bool hasAnyConnections;

    // The display order of the "connected records" sections. Every entity category appears
    // here, so a single relationship lookup can be fanned out into the right headings.
    private static readonly (string Title, Func<DuneEntity, bool> Matches)[] Sections =
    {
        ("Personas", e => e is Persona),
        ("Houses", e => e is House),
        ("Organizations", e => e is Organization),
        ("Worlds & Locations", e => e is World),
        ("Artifacts", e => e is Artifact),
        ("Vehicles", e => e is Vehicle),
        ("Disciplines", e => e is Discipline),
        ("Theological Systems", e => e is TheologicalSystem),
        ("Historical Events", e => e is HistoricalEvent),
        ("Flora & Fauna", e => e is FloraFauna),
    };

    protected override void OnParametersSet()
    {
        // A fresh entity address means the reveal choice starts over.
        revealed = false;

        var result = Registry.Resolve(Id);
        entity = result.Entity;
        candidates = result.Candidates.Where(Spoiler.IsVisible).ToList();

        if (entity is null)
        {
            isGated = false;
            return;
        }

        isGated = !Spoiler.IsVisible(entity);

        // If the URL used a name or a typo rather than the canonical ID, normalize the
        // address bar so links and bookmarks always point at the real ID.
        if (!string.Equals(entity.Id, Id, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"/entity/{entity.Id}", replace: true);
            return;
        }

        // Every connection is filtered through the spoiler gate, so a related entity from a book
        // the reader hasn't reached never surfaces as a link, a rivalry, or a graph node.
        rivals = entity is House house
            ? Registry.GetRivalHouses(house.Id).Where(Spoiler.IsVisible).ToList()
            : new List<House>();

        // A house or order can now name the people who belong to it, which until now only ran
        // the other way. Alphabetical, since a roster has no natural order of importance.
        members = entity is House or Organization
            ? Registry.GetAffiliates(entity.Name)
                .Where(Spoiler.IsVisible)
                .OrderBy(person => person.Name, StringComparer.OrdinalIgnoreCase)
                .Cast<DuneEntity>()
                .ToList()
            : new List<DuneEntity>();

        related = Registry.GetDirectlyRelated(entity.Id).Where(Spoiler.IsVisible).ToList();
        hasAnyConnections = related.Count > 0;
    }

    private void Reveal()
    {
        revealed = true;
    }

    // What the given related entity is to the one being viewed ("Mother", "Betrayer of his
    // House"), or null when the pair has no label or the label belongs to a book the reader
    // hasn't reached. The connection itself still shows; only its meaning is held back.
    private string? RoleFor(string otherId)
    {
        if (entity is null)
        {
            return null;
        }

        return Registry.GetRelationshipLabel(entity.Id, otherId) is { } label && Spoiler.IsVisible(label.Tier)
            ? label.Role
            : null;
    }

    // One labeled fact from a record. Value carries a single string; Items carries a list
    // field (a world's customs, a faith's texts), which renders as a list rather than prose.
    private sealed record MetaRow(string Label, string? Value = null, IReadOnlyList<string>? Items = null);

    // The per-category fields each record type carries, mapped to the labels a reader sees.
    // Rows with nothing in them drop out, so a record never shows an empty line. Labels are
    // reader-facing rather than field names: EnvironmentalData reads as "Environment".
    private static IReadOnlyList<MetaRow> MetaRowsFor(DuneEntity entity)
    {
        // Other names come first and apply to every kind of record, so a reader who arrived
        // knowing one name learns the others before reading anything else. Joined into a
        // single line rather than stacked, since these are short and belong together.
        var aliasRow = entity.Aliases.Count > 0
            ? new[] { new MetaRow("Also Known As", string.Join(", ", entity.Aliases)) }
            : Array.Empty<MetaRow>();

        var rows = entity switch
        {
            Persona persona => new[]
            {
                new MetaRow("Role", persona.Role),
                new MetaRow("Affiliation", persona.Affiliation),
            },
            World world => new[]
            {
                new MetaRow("Environment", world.EnvironmentalData),
                new MetaRow("Ruling House", world.RulingHouse),
                new MetaRow("Local Customs", Items: world.LocalCustoms),
            },
            House house => new[]
            {
                new MetaRow("Sigil", house.Sigil),
                new MetaRow("Motto", house.Motto),
            },
            Organization org => new[]
            {
                new MetaRow("Headquarters", org.Headquarters),
                new MetaRow("Directive", org.PrimaryDirective),
            },
            Artifact artifact => new[]
            {
                new MetaRow("Material", artifact.PrimaryMaterial),
                new MetaRow("Function", artifact.Functionality),
            },
            Vehicle vehicle => new[]
            {
                new MetaRow("Operates In", vehicle.OperatingEnvironment),
                new MetaRow("Capacity", vehicle.Capacity),
            },
            Discipline discipline => new[]
            {
                new MetaRow("Requirements", discipline.Requirements),
                new MetaRow("Method", discipline.Mechanics),
            },
            TheologicalSystem theology => new[]
            {
                new MetaRow("Core Tenets", theology.CoreTenets),
                new MetaRow("Foundational Texts", Items: theology.FoundationalTexts),
            },
            FloraFauna floraFauna => new[]
            {
                new MetaRow("Classification", floraFauna.BiologicalClassification),
                new MetaRow("Derived Products", floraFauna.DerivedProducts),
            },
            HistoricalEvent historicalEvent => new[]
            {
                new MetaRow("Date", historicalEvent.DateAG),
                new MetaRow("Timeframe", historicalEvent.Timeframe),
                new MetaRow("Lasting Impact", historicalEvent.LastingImpact),
            },
            _ => Array.Empty<MetaRow>(),
        };

        return aliasRow
            .Concat(rows)
            .Where(row => row.Items is { Count: > 0 } || HasFact(row.Value))
            .ToList();
    }

    // Whether a value says anything a reader did not already know from its absence. The
    // archive's usual way of recording a gap explains itself ("None; purely an ecological
    // scavenger", "Unknown (beyond the Scattering)"), and those are kept: the absence is the
    // fact. A bare "Not widely recorded" is the one form that adds nothing, and it sits on
    // both the sigil and the motto of most minor houses, where the repetition reads as a
    // template artifact rather than an archival note. Matched exactly, so a qualified version
    // that does carry information ("Not widely recorded outside Grumman") still shows.
    private static bool HasFact(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && !string.Equals(value.Trim(), "Not widely recorded", StringComparison.OrdinalIgnoreCase);

    // Reader-facing description of the tier a gated entry belongs to, used in the spoiler notice.
    private static string BookName(SpoilerTier tier) => tier switch
    {
        SpoilerTier.DuneMessiah => "Dune Messiah",
        SpoilerTier.ChildrenOfDune => "Children of Dune",
        SpoilerTier.GodEmperorOfDune => "God Emperor of Dune",
        SpoilerTier.HereticsOfDune => "Heretics of Dune",
        SpoilerTier.Chapterhouse => "Chapterhouse: Dune",
        SpoilerTier.ExpandedUniverse => "the Expanded Universe (prequels and sequels)",
        _ => "Dune",
    };
}
