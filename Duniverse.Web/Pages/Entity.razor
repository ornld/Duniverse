@page "/entity/{Id}"
@inject EntityRegistry Registry
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler

<PageTitle>@((entity is not null && isGated && !revealed) ? "Spoiler-protected entry" : (entity?.Name ?? "Not Found")) - Duniverse Archives</PageTitle>

<a class="back-link" href="/archives">&larr; Back to Duniverse Archive</a>

@if (entity is not null && isGated && !revealed)
{
    <div class="entity-card front spoiler-gate">
        <h1>A spoiler lies ahead</h1>
        <p class="short-desc">This entry draws on @BookName(entity.SpoilerTier).</p>
        <p>
            You've set your reading progress to stop short of that. You can reveal this entry
            anyway, or head back and keep exploring what's safe for you.
        </p>
        <div class="gate-actions">
            <button class="surprise-btn" @onclick="Reveal">Reveal this entry</button>
            <a class="chip" href="/archives">Back to search</a>
        </div>
    </div>
}
else if (entity is not null)
{
    <div class="entity-card front">
        <h1>@entity.Name</h1>
        <p class="short-desc">@entity.ShortDescription</p>

        @if (entity is Persona metaPersona && (!string.IsNullOrWhiteSpace(metaPersona.Role) || !string.IsNullOrWhiteSpace(metaPersona.Affiliation)))
        {
            <dl class="entity-meta">
                @if (!string.IsNullOrWhiteSpace(metaPersona.Role))
                {
                    <div class="meta-row">
                        <dt>Role</dt>
                        <dd>@metaPersona.Role</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(metaPersona.Affiliation))
                {
                    <div class="meta-row">
                        <dt>Affiliation</dt>
                        <dd>@metaPersona.Affiliation</dd>
                    </div>
                }
            </dl>
        }

        @if (!string.IsNullOrEmpty(entity.DetailedHistory))
        {
            <p class="detailed-history">@entity.DetailedHistory</p>
        }

        @if (entity is Persona quotedPersona && quotedPersona.NotableQuotes.Count > 0)
        {
            <div class="entity-quotes">
                @foreach (var quote in quotedPersona.NotableQuotes)
                {
                    <blockquote class="entity-quote">"@quote"</blockquote>
                }
            </div>
        }

        @if (entity is House && rivals.Count > 0)
        {
            <p class="rivalries">
                <strong>Historical Rivalries:</strong> @string.Join(", ", rivals.Select(rival => rival.Name))
            </p>
        }
    </div>

    <div class="connections-divider">
        <span>Connected relationships throughout the Duniverse</span>
    </div>

    @if (hasAnyConnections)
    {
        <div class="entity-card graph-card">
            <RelationshipGraph CenterId="@entity.Id" />
        </div>
    }

    <div class="entity-card back">
        <RelatedSection Title="Personas" Items="relatedPersonas" />
        <RelatedSection Title="Houses" Items="relatedHouses" />
        <RelatedSection Title="Organizations" Items="relatedOrganizations" />
        <RelatedSection Title="Worlds & Locations" Items="relatedWorlds" />
        <RelatedSection Title="Artifacts" Items="relatedArtifacts" />
        <RelatedSection Title="Vehicles" Items="relatedVehicles" />
        <RelatedSection Title="Disciplines" Items="relatedDisciplines" />
        <RelatedSection Title="Theological Systems" Items="relatedTheologicalSystems" />
        <RelatedSection Title="Historical Events" Items="relatedHistoricalEvents" />
        <RelatedSection Title="Flora & Fauna" Items="relatedFloraFauna" />

        @if (!hasAnyConnections)
        {
            <p class="muted">No connected records found.</p>
        }
    </div>
}
else if (candidates.Count > 0)
{
    <div class="entity-card front">
        <h2>@candidates.Count records match "@Id"</h2>
        <p>Did you mean:</p>
        <ul>
            @foreach (var candidate in candidates)
            {
                <li>
                    <a href="@($"/entity/{candidate.Id}")">@candidate.Name</a>
                    <span class="muted">@candidate.ShortDescription</span>
                </li>
            }
        </ul>
    </div>
}
else
{
    <div class="entity-card front">
        <h2>No record found for "@Id"</h2>
        <p>Verify the ID or name and try again.</p>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private DuneEntity? entity;
    private bool isGated;
    private bool revealed;
    private List<House> rivals = new();
    private List<DuneEntity> candidates = new();
    private bool hasAnyConnections;

    private List<Persona> relatedPersonas = new();
    private List<House> relatedHouses = new();
    private List<Organization> relatedOrganizations = new();
    private List<World> relatedWorlds = new();
    private List<Artifact> relatedArtifacts = new();
    private List<Vehicle> relatedVehicles = new();
    private List<Discipline> relatedDisciplines = new();
    private List<TheologicalSystem> relatedTheologicalSystems = new();
    private List<HistoricalEvent> relatedHistoricalEvents = new();
    private List<FloraFauna> relatedFloraFauna = new();

    protected override void OnParametersSet()
    {
        // A fresh entity address means the reveal choice starts over.
        revealed = false;

        var result = Registry.Resolve(Id);
        entity = result.Entity;
        candidates = result.Candidates.Where(Spoiler.IsVisible).ToList();

        if (entity is null)
        {
            isGated = false;
            return;
        }

        isGated = !Spoiler.IsVisible(entity);

        // If the URL used a name or a typo rather than the canonical ID, normalize the
        // address bar so links and bookmarks always point at the real ID.
        if (!string.Equals(entity.Id, Id, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"/entity/{entity.Id}", replace: true);
            return;
        }

        // Every connection is filtered through the spoiler gate, so a related entity from a book
        // the reader hasn't reached never surfaces as a link, a rivalry, or a graph node.
        rivals = entity is House house
            ? Registry.GetRivalHouses(house.Id).Where(Spoiler.IsVisible).ToList()
            : new List<House>();

        relatedPersonas = Registry.GetRelatedEntities<Persona>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedHouses = Registry.GetRelatedEntities<House>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedOrganizations = Registry.GetRelatedEntities<Organization>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedWorlds = Registry.GetRelatedEntities<World>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedArtifacts = Registry.GetRelatedEntities<Artifact>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedVehicles = Registry.GetRelatedEntities<Vehicle>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedDisciplines = Registry.GetRelatedEntities<Discipline>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedTheologicalSystems = Registry.GetRelatedEntities<TheologicalSystem>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedHistoricalEvents = Registry.GetRelatedEntities<HistoricalEvent>(entity.Id).Where(Spoiler.IsVisible).ToList();
        relatedFloraFauna = Registry.GetRelatedEntities<FloraFauna>(entity.Id).Where(Spoiler.IsVisible).ToList();

        hasAnyConnections =
            relatedPersonas.Count > 0 ||
            relatedHouses.Count > 0 ||
            relatedOrganizations.Count > 0 ||
            relatedWorlds.Count > 0 ||
            relatedArtifacts.Count > 0 ||
            relatedVehicles.Count > 0 ||
            relatedDisciplines.Count > 0 ||
            relatedTheologicalSystems.Count > 0 ||
            relatedHistoricalEvents.Count > 0 ||
            relatedFloraFauna.Count > 0;
    }

    private void Reveal()
    {
        revealed = true;
    }

    // Reader-facing description of the tier a gated entry belongs to, used in the spoiler notice.
    private static string BookName(SpoilerTier tier) => tier switch
    {
        SpoilerTier.DuneMessiah => "Dune Messiah",
        SpoilerTier.ChildrenOfDune => "Children of Dune",
        SpoilerTier.GodEmperorOfDune => "God Emperor of Dune",
        SpoilerTier.HereticsOfDune => "Heretics of Dune",
        SpoilerTier.Chapterhouse => "Chapterhouse: Dune",
        SpoilerTier.ExpandedUniverse => "the Expanded Universe (prequels and sequels)",
        _ => "Dune",
    };
}
