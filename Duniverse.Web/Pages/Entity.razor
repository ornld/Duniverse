@page "/entity/{Id}"
@inject EntityRegistry Registry
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler
@inject UnsealedRecords Unsealed

<PageTitle>@((entity is not null && isGated && !revealed) ? "Spoiler-protected entry" : (entity?.Name ?? "Not Found")) - Duniverse</PageTitle>

<a class="back-link" href="@BackHref">&larr; @BackLabel</a>

@if (entity is not null && isGated && !revealed)
{
    <div class="entity-card front spoiler-gate dossier-item category-@GraphLayoutService.CategorySlug(entity)" style="--i: 0" @key="entity.Id">
        <h1>A spoiler lies ahead</h1>
        <p class="short-desc">This entry draws on @BookName(entity.SpoilerTier).</p>
        <p>
            Your reading progress is set to stop short of that. You can reveal this entry
            anyway, adjust your progress on the Archives page, or head back and keep exploring
            what's safe for you.
        </p>
        <div class="gate-actions">
            <button class="surprise-btn" @onclick="Reveal">Reveal this entry</button>
            <a class="chip" href="/archives">Back to search</a>
        </div>
    </div>
}
else if (entity is not null)
{
    @* One keyed wrapper per record: walking from one entity to another rebuilds this
       subtree, so the dossier entrance below replays for every newly opened record. *@
    <div @key="entity.Id">
    <div class="entity-card front dossier-item category-@GraphLayoutService.CategorySlug(entity)" style="--i: 0">
        <h1>@entity.Name</h1>
        <p class="short-desc">@entity.ShortDescription</p>

        @* Every category stores its facts in different fields, so MetaRowsFor flattens all
           of them into the same labeled rows. I want a world's environment and a house's
           motto reading as one archive, not nine formats. *@
        @if (MetaRowsFor(entity) is { Count: > 0 } metaRows)
        {
            <dl class="entity-meta">
                @foreach (var row in metaRows)
                {
                    <div class="meta-row">
                        <dt>@row.Label</dt>
                        <dd>
                            @if (row.Parts is not null)
                            {
                                @foreach (var part in row.Parts)
                                {
                                    if (part.Href is null)
                                    {
                                        @part.Text
                                    }
                                    else
                                    {
                                        <a href="@part.Href">@part.Text</a>
                                    }
                                }
                            }
                            else if (row.Items is not null)
                            {
                                <ul class="meta-list">
                                    @foreach (var item in row.Items)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                @row.Value
                            }
                        </dd>
                    </div>
                }
            </dl>
        }

        @* Every record opens safe, then adds passages a further book earns, like Irulan's
           history and its correctives. I show the marks only once every passage is earned,
           so a label can never describe a paragraph they haven't been given. *@
        @if (ShowEditionMarks)
        {
            <p class="edition-note">
                @* aria-pressed spelled out as a string for the same reason the Index trigger
                   does it: handed a bool, Blazor drops the attribute when false and writes it
                   empty when true, so the state never reaches a screen reader at all. *@
                <button type="button" class="edition-toggle"
                        aria-pressed="@(editionMarks ? "true" : "false")"
                        @onclick="() => editionMarks = !editionMarks">
                    @(editionMarks ? "Hide which book opens each part" : "Show which book opens each part")
                </button>
            </p>
        }

        @if (!string.IsNullOrEmpty(entity.DetailedHistory))
        {
            @if (ShowEditionMarks && editionMarks)
            {
                <p class="edition-mark">@BookName(entity.SpoilerTier)</p>
            }
            <p class="detailed-history">@entity.DetailedHistory</p>
        }

        @* The rest of the story, as far as the reader has read. A record whose subject never
           outlives its first book has no layers at all and this adds nothing. *@
        @foreach (var layer in EntityRegistry.VisibleLayers(entity, Spoiler.IsVisible))
        {
            @if (ShowEditionMarks && editionMarks)
            {
                <p class="edition-mark">@BookName(layer.Tier)</p>
            }
            <p class="detailed-history @(newlyOpened.Contains(layer.Tier) ? "layer-unsealing" : "")">@layer.Text</p>
        }

        @if (entity is Persona quotedPersona && quotedPersona.NotableQuotes.Count > 0)
        {
            <div class="entity-quotes">
                @foreach (var quote in quotedPersona.NotableQuotes)
                {
                    <blockquote class="entity-quote">"@quote"</blockquote>
                }
            </div>
        }

        @* Every rival is a record the reader can open. These were a joined string before,
           which named the enemy and then refused to take you there. *@
        @if (entity is House && rivals.Count > 0)
        {
            <p class="rivalries">
                <strong>Historical Rivalries:</strong>
                @for (int i = 0; i < rivals.Count; i++)
                {
                    var rival = rivals[i];
                    @(i > 0 ? ", " : " ")<a href="@($"/entity/{rival.Id}")">@rival.Name</a>
                }
            </p>
        }
    </div>

    @* Who belongs to this house or order, read off the membership each person's own
       record declares. I keep it next to the description instead of down with the
       connections, since membership is part of what the house is. *@
    @if (members.Count > 0)
    {
        <div class="entity-card roster-card dossier-item" style="--i: 1">
            <RelatedSection Title="Known Members" Items="members" RoleFor="MemberRoleFor" />
        </div>
    }

    @* Where a person stands in the line. The component draws nothing for anyone the chart
       does not hold, so it costs a record outside the Houses nothing. *@
    @if (entity is Persona)
    {
        <BloodlineStrip CenterId="@entity.Id" />
    }

    <div class="connections-divider dossier-item" style="--i: 2">
        <span>Connected relationships throughout the Duniverse</span>
    </div>

    @if (hasAnyConnections)
    {
        <div class="entity-card graph-card dossier-item" style="--i: 3">
            <RelationshipGraph CenterId="@entity.Id" />
        </div>
    }

    @* Doors out of the record and into the site's bigger tools, each already aimed at
       this entity. Bloodlines only shows for people who actually stand in the chart. *@
    <nav class="entity-explore dossier-item" style="--i: 4" aria-label="Explore this record further">
        <a class="explore-link" href="@($"/connections?from={entity.Id}")">
            <Mark Name="connections" CssClass="explore-glyph" />Trace a connection from here
        </a>
        <a class="explore-link" href="@($"/universe?focus={entity.Id}")">
            <Mark Name="universe" CssClass="explore-glyph" />See it in the whole Duniverse
        </a>
        @if (InBloodline)
        {
            <a class="explore-link" href="@($"/bloodlines?focus={entity.Id}")">
                <Mark Name="bloodlines" CssClass="explore-glyph" />View in the bloodlines
            </a>
        }
    </nav>

    <div class="entity-card back dossier-item" style="--i: 5">
        @foreach (var group in Sections)
        {
            <RelatedSection Title="@group.Title" Items="related.Where(group.Matches)" RoleFor="RoleFor" />
        }

        @if (!hasAnyConnections)
        {
            <p class="muted">No connected records found.</p>
        }
    </div>

    @* The words the Terminology defines against this record. That link ran one way only, so
       the glossary knew about the record and the record never knew about the glossary. *@
    @if (glossary.Count > 0)
    {
        <div class="entity-card roster-card dossier-item" style="--i: 6">
            <div class="related-section">
                <h3>In the Terminology</h3>
                <dl class="glossary">
                    @foreach (var term in glossary)
                    {
                        <div class="glossary-entry">
                            <dt>@term.Term</dt>
                            <dd>@term.Definition</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
    }
    </div>
}
else if (candidates.Count > 0)
{
    <div class="entity-card front">
        <h2>@candidates.Count records match "@Id"</h2>
        <p>Did you mean:</p>
        <ul>
            @foreach (var candidate in candidates)
            {
                <li>
                    <a href="@($"/entity/{candidate.Id}")">@candidate.Name</a>
                    <span class="muted">@candidate.ShortDescription</span>
                </li>
            }
        </ul>
    </div>
}
else
{
    @* Nothing matched, not even loosely. That's the same dead end the 404 covers, so it
       gets the same desert instead of a bare card. *@
    <LostDesert>
        Nothing in the archive answers to "@Id". Check the spelling, or go looking for
        the record by name.
    </LostDesert>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private DuneEntity? entity;
    private bool isGated;
    private bool revealed;
    private bool editionMarks;

    /// <summary>
    /// The layers that opened since this reader last looked at this record, marked once and
    /// then written down. Empty on a first visit: arriving somewhere is not unlocking it.
    /// </summary>
    private IReadOnlyList<SpoilerTier> newlyOpened = Array.Empty<SpoilerTier>();

    /// <summary>
    /// Whether I name the book behind each passage. Keyed to reader progress, never the
    /// record: layers and base text share markup, so two paragraphs and no button would
    /// mean a third they haven't reached. A button was worse: Chani carrying one meant
    /// Chani never comes up again.
    /// </summary>
    private bool ShowEditionMarks =>
        entity is not null
        && !string.IsNullOrEmpty(entity.DetailedHistory)
        && AtFullProgress;

    /// <summary>
    /// True once nothing in the archive is being held back from this reader, either because
    /// they turned protection off or because they have read to the end of the spine and opted
    /// into the Expanded Universe.
    /// </summary>
    private bool AtFullProgress =>
        !Spoiler.Enabled
        || (Spoiler.NovelProgress >= SpoilerTier.Chapterhouse && Spoiler.IncludeExpandedUniverse);

    // A resolved record sends "back" to its own category page, so Index to category to
    // record returns you where you started. A typo with several matches or nothing found
    // has no single category, so those keep the Archives fallback.
    private string BackHref =>
        entity is not null && GraphLayoutService.CategorySlug(entity) is var slug and not "unknown"
            ? $"/category/{slug}"
            : "/archives";

    private string BackLabel =>
        entity is not null && GraphLayoutService.CategorySlug(entity) != "unknown"
            ? $"Back to {GraphLayoutService.CategoryTitle(entity)}"
            : "Back to Archives";

    // True only when this record actually stands in the Bloodlines chart at the reader's
    // progress, so the "View in the bloodlines" door never points at a chart without them.
    private bool InBloodline =>
        entity is not null
        && BloodlineMap.Nodes.FirstOrDefault(n =>
            string.Equals(n.EntityId, entity.Id, StringComparison.OrdinalIgnoreCase)) is { } node
        && Spoiler.IsVisible(node.Tier);
    private List<House> rivals = new();
    private List<DuneEntity> members = new();
    private List<DuneEntity> candidates = new();
    private List<DuneEntity> related = new();
    private List<GlossaryTerm> glossary = new();
    private bool hasAnyConnections;

    // The display order of the "connected records" sections. Every entity category
    // appears here, so one relationship lookup can fan out into the right headings.
    private static readonly (string Title, Func<DuneEntity, bool> Matches)[] Sections =
    {
        ("Personas", e => e is Persona),
        ("Houses", e => e is House),
        ("Organizations", e => e is Organization),
        ("Worlds & Locations", e => e is World),
        ("Artifacts", e => e is Artifact),
        ("Vehicles", e => e is Vehicle),
        ("Disciplines", e => e is Discipline),
        ("Theological Systems", e => e is TheologicalSystem),
        ("Historical Events", e => e is HistoricalEvent),
        ("Flora & Fauna", e => e is FloraFauna),
    };

    /// <summary>
    /// Works out what opened since this reader last looked here, then writes down what they
    /// see now. Runs after OnParametersSet, so the record is resolved. A gated record seeds
    /// an empty entry, so its layers arrive marked later.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (entity is null)
        {
            return;
        }

        await Unsealed.LoadAsync();

        var visible = EntityRegistry.VisibleLayers(entity, Spoiler.IsVisible)
            .Select(layer => layer.Tier)
            .ToList();

        // Read before writing. Reversing these two lines would mark every layer as witnessed a
        // moment before asking which of them were new, and nothing would ever be announced.
        newlyOpened = Unsealed.NewlyOpened(entity.Id, visible);
        await Unsealed.WitnessAsync(entity.Id, visible);
    }

    protected override void OnParametersSet()
    {
        // A fresh entity address means the reveal choice starts over, and the edition marks
        // close with it: they are a study aid for one record, not a mode the site stays in.
        revealed = false;
        editionMarks = false;
        newlyOpened = Array.Empty<SpoilerTier>();

        var result = Registry.Resolve(Id);
        entity = result.Entity;
        candidates = result.Candidates.Where(Spoiler.IsVisible).ToList();

        if (entity is null)
        {
            isGated = false;
            return;
        }

        isGated = !Spoiler.IsVisible(entity);

        // A name or typo swaps to the canonical ID so links and bookmarks agree. Never on
        // a sealed entry: that ID writes the refused name into history. Skipping costs
        // nothing, since the gate reads the same at any address.
        if (!isGated && !string.Equals(entity.Id, Id, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"/entity/{entity.Id}", replace: true);
            return;
        }

        // Every connection runs through the spoiler gate, so a related entity from a
        // book the reader hasn't reached never shows up as a link, a rivalry, or a
        // graph node.
        rivals = entity is House house
            ? Registry.GetRivalHouses(house.Id).Where(Spoiler.IsVisible).ToList()
            : new List<House>();

        // A house or order can name its own people, not just the other way. I look them
        // up by ID, not display name: matching on prose put people on the wrong rosters.
        // Alphabetical, since a roster has no ranking.
        members = entity is House or Organization
            ? Registry.GetAffiliates(entity.Id)
                .Where(Spoiler.IsVisible)
                .OrderBy(person => person.Name, StringComparer.OrdinalIgnoreCase)
                .Cast<DuneEntity>()
                .ToList()
            : new List<DuneEntity>();

        related = Registry.GetDirectlyRelated(entity.Id, Spoiler.IsVisible).Where(Spoiler.IsVisible).ToList();
        hasAnyConnections = related.Count > 0;

        // A term carries its own tier, so a word coined in a later book stays out even on a
        // record the reader already holds.
        glossary = GlossarySeeder.TermsByEntity.TryGetValue(entity.Id, out var terms)
            ? terms.Where(term => Spoiler.IsVisible(term.Tier)).ToList()
            : new List<GlossaryTerm>();
    }

    private void Reveal()
    {
        revealed = true;
    }

    // What the related entity is to the one being viewed ("Mother", say), or null when
    // there is no label or its book sits past the reader's progress. The connection
    // still shows, only its meaning is held back.
    private string? RoleFor(string otherId)
    {
        if (entity is null)
        {
            return null;
        }

        return Registry.GetRelationshipLabel(entity.Id, otherId) is { } label && Spoiler.IsVisible(label.Tier)
            ? label.Role
            : null;
    }

    // One labeled fact from a record. Value carries a single string; Items carries a
    // list field (a world's customs, a faith's texts), which renders as a list
    // instead of prose.
    private sealed record MetaRow(string Label, string? Value = null, IReadOnlyList<string>? Items = null,
        IReadOnlyList<MetaPart>? Parts = null);

    // One piece of a fact line: plain words, or words that open a record. Affiliation runs on
    // these so the prose keeps its own shape and still carries links.
    private sealed record MetaPart(string Text, string? Href);

    // Affiliation is written for a reader and the ids cannot match it: "Fremen (secretly House
    // Corrino)" says something no roster holds. So I link each roster where its name already
    // sits in the sentence, and add the rest.
    private IReadOnlyList<MetaPart> AffiliationParts(Persona persona)
    {
        var rosters = persona.AffiliationIds
            .Select(Registry.GetEntity)
            .OfType<DuneEntity>()
            .Where(Spoiler.IsVisible)
            .ToList();

        var prose = persona.Affiliation ?? string.Empty;
        var parts = new List<MetaPart>();
        var placed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        int at = 0;
        while (at < prose.Length)
        {
            // Longest name first, so "House Corrino" wins over a bare "Corrino" sitting inside it.
            var next = rosters
                .Select(roster => (Roster: roster, At: prose.IndexOf(roster.Name, at, StringComparison.OrdinalIgnoreCase)))
                .Where(found => found.At >= 0)
                .OrderBy(found => found.At)
                .ThenByDescending(found => found.Roster.Name.Length)
                .FirstOrDefault();

            if (next.Roster is null)
            {
                break;
            }

            if (next.At > at)
            {
                parts.Add(new MetaPart(prose[at..next.At], null));
            }

            parts.Add(new MetaPart(prose.Substring(next.At, next.Roster.Name.Length), $"/entity/{next.Roster.Id}"));
            placed.Add(next.Roster.Id);
            at = next.At + next.Roster.Name.Length;
        }

        if (at < prose.Length)
        {
            parts.Add(new MetaPart(prose[at..], null));
        }

        foreach (var missing in rosters.Where(roster => !placed.Contains(roster.Id)))
        {
            parts.Add(new MetaPart(parts.Count > 0 ? ", " : string.Empty, null));
            parts.Add(new MetaPart(missing.Name, $"/entity/{missing.Id}"));
        }

        return parts;
    }

    // A roster reads better saying what each person was. Role belongs to them rather than to
    // this house, so it skips the relationship lookup the connection lists use.
    private string? MemberRoleFor(string memberId) =>
        Registry.GetEntity(memberId) is Persona person && !string.IsNullOrWhiteSpace(person.Role)
            ? person.Role
            : null;

    // The per-category fields each record type carries, mapped to the labels a
    // reader sees. Rows with nothing in them drop out, so a record never shows an
    // empty line. Labels are for readers, not field names: EnvironmentalData shows
    // as "Environment".
    private IReadOnlyList<MetaRow> MetaRowsFor(DuneEntity entity)
    {
        // Other names come first and apply to every kind of record, so someone who
        // arrived knowing one name learns the others before reading anything else.
        // Joined into a single line instead of stacked, since these are short and
        // belong together.
        var aliasRow = entity.Aliases.Count > 0
            ? new[] { new MetaRow("Also Known As", string.Join(", ", entity.Aliases)) }
            : Array.Empty<MetaRow>();

        var rows = entity switch
        {
            Persona persona => new[]
            {
                new MetaRow("Role", persona.Role),
                new MetaRow("Affiliation", persona.Affiliation, Parts: AffiliationParts(persona)),
            },
            World world => new[]
            {
                new MetaRow("Environment", world.EnvironmentalData),
                new MetaRow("Ruling House", world.RulingHouse),
                new MetaRow("Local Customs", Items: world.LocalCustoms),
            },
            House house => new[]
            {
                new MetaRow("Sigil", house.Sigil),
                new MetaRow("Motto", house.Motto),
            },
            Organization org => new[]
            {
                new MetaRow("Headquarters", org.Headquarters),
                new MetaRow("Directive", org.PrimaryDirective),
            },
            Artifact artifact => new[]
            {
                new MetaRow("Material", artifact.PrimaryMaterial),
                new MetaRow("Function", artifact.Functionality),
            },
            Vehicle vehicle => new[]
            {
                new MetaRow("Operates In", vehicle.OperatingEnvironment),
                new MetaRow("Capacity", vehicle.Capacity),
            },
            Discipline discipline => new[]
            {
                new MetaRow("Requirements", discipline.Requirements),
                new MetaRow("Method", discipline.Mechanics),
            },
            TheologicalSystem theology => new[]
            {
                new MetaRow("Core Tenets", theology.CoreTenets),
                new MetaRow("Foundational Texts", Items: theology.FoundationalTexts),
            },
            FloraFauna floraFauna => new[]
            {
                new MetaRow("Classification", floraFauna.BiologicalClassification),
                new MetaRow("Derived Products", floraFauna.DerivedProducts),
            },
            HistoricalEvent historicalEvent => new[]
            {
                new MetaRow("Date", historicalEvent.DateAG),
                new MetaRow("Timeframe", historicalEvent.Timeframe),
                new MetaRow("Lasting Impact", historicalEvent.LastingImpact),
            },
            _ => Array.Empty<MetaRow>(),
        };

        return aliasRow
            .Concat(rows)
            .Where(row => row.Items is { Count: > 0 } || row.Parts is { Count: > 0 } || HasFact(row.Value))
            .ToList();
    }

    // Whether a value says anything its absence wouldn't. Gaps that explain themselves
    // stay: the absence is the fact. Bare "Not widely recorded" sat on most minor houses
    // and said nothing. Matched exactly, so "Not widely recorded outside Grumman"
    // survives.
    private static bool HasFact(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && !string.Equals(value.Trim(), "Not widely recorded", StringComparison.OrdinalIgnoreCase);

    // The reader-facing name of the book a gated entry draws on, for the spoiler
    // notice.
    private static string BookName(SpoilerTier tier) => tier switch
    {
        SpoilerTier.DuneMessiah => "Dune Messiah",
        SpoilerTier.ChildrenOfDune => "Children of Dune",
        SpoilerTier.GodEmperorOfDune => "God Emperor of Dune",
        SpoilerTier.HereticsOfDune => "Heretics of Dune",
        SpoilerTier.Chapterhouse => "Chapterhouse: Dune",
        SpoilerTier.ExpandedUniverse => "the Expanded Universe (prequels and sequels)",
        _ => "Dune",
    };
}
