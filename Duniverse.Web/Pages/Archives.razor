@page "/archives"
@inject EntityRegistry Registry
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler

<PageTitle>Archives - Duniverse</PageTitle>

<div class="hero search-hero" style="background-image: var(--scrim-soft), url('/images/entity-front-background.webp');">
    <h1>Archives</h1>
    <p class="tagline">
        Search for anyone or anything in the Dune universe.
    </p>

    <div class="search-box">
        @* A placeholder is not a name: it vanishes on the first keystroke and screen readers
           are not obliged to read it. The search box is the whole point of this page. *@
        <input @bind="query" @bind:event="oninput" @onkeyup="HandleKeyUp"
               aria-label="Search the archive by name or ID"
               placeholder="Ask for a name or an ID: Paul Atreides, Arrakis, Bene Gesserit..." />
        <button @onclick="HandleSearch">Search</button>
    </div>

    @* Results settle the way everything else the archive hands over does: header first,
       rows on their own beats, the beats capped so a long list arrives as one motion.
       Keyed per search, so a fresh query replays the landing. *@
    @if (notFound)
    {
        <p class="no-results result-settle" style="--i: 0" @key="@($"none-{searchEpoch}")">No matching records found for "@lastQuery". Check the spelling and try again.</p>
    }

    @if (candidates.Count > 0)
    {
        <div class="candidates" @key="@($"names-{searchEpoch}")">
            <p class="result-settle" style="--i: 0">@candidates.Count records match "@lastQuery". Did you mean:</p>
            <ul>
                @for (var i = 0; i < candidates.Count; i++)
                {
                    var candidate = candidates[i];
                    var slug = GraphLayoutService.CategorySlug(candidate);
                    <li class="result-settle" style="--i: @Math.Min(i + 1, 8)">
                        @* Which drawer each match comes out of. A mixed list of names read
                           as one kind of thing without it. *@
                        <Mark Name="@slug" CssClass="@($"candidate-mark connection-cat category-{slug}")" />
                        <a href="@($"/entity/{candidate.Id}")">@candidate.Name</a>
                        <span class="muted">@candidate.ShortDescription</span>
                    </li>
                }
            </ul>
        </div>
    }

    @* Records the query never names, but whose text mentions it. I keep these below
       the name matches and always as a list, never a jump: a phrase buried in prose
       is a weaker claim than a name. *@
    @if (contentMatches.Count > 0)
    {
        <div class="candidates text-matches" @key="@($"text-{searchEpoch}")">
            <p class="result-settle" style="--i: @Math.Min(candidates.Count + 1, 8)">
                @(candidates.Count > 0 ? "Also mentioned" : "Mentioned")
                in the text of @contentMatchTotal @(contentMatchTotal == 1 ? "record" : "records")@(contentMatchTotal > contentMatches.Count ? $", closest {contentMatches.Count} first" : ""):
            </p>
            <ul>
                @for (var j = 0; j < contentMatches.Count; j++)
                {
                    var match = contentMatches[j];
                    <li class="result-settle" style="--i: @Math.Min(candidates.Count + 2 + j, 8)">
                        <a href="@($"/entity/{match.Id}")">@match.Name</a>
                        <span class="muted">@(Snippet(match, lastQuery) ?? match.ShortDescription)</span>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="examples">
        <span class="examples-label">Start anywhere:</span>
        @foreach (var example in Examples)
        {
            <a class="chip" href="@($"/entity/{example.Id}")">@example.Label</a>
        }
    </div>

    <p class="surprise-line">
        Anywhere is a beginning.
        <button class="surprise-btn" @onclick="RandomJump">Let the archive choose</button>
    </p>

    @* Keyed to the epoch so changing reading progress recounts the seals straight away, rather
       than leaving a stale number sitting under the control that just changed it. *@
    <SpoilerControl OnChanged="OnProgressChanged" />
    <ImperialSeal All="everyRecord" Scope="in the archive" @key="sealEpoch" />
</div>

@code {
    private string query = "";
    private string lastQuery = "";
    private List<DuneEntity> everyRecord = new();
    private int sealEpoch;
    private int searchEpoch;
    private bool notFound;
    private List<DuneEntity> rawCandidates = new();
    private List<DuneEntity> candidates = new();
    private List<DuneEntity> rawContentMatches = new();
    private List<DuneEntity> contentMatches = new();

    // Enough to be useful without a common word burying the page in a hundred entries.
    private const int MaxContentMatches = 10;

    // How many records mention the phrase in total, before the display cap. Kept
    // separate so the heading can be honest about a list it only shows the top of.
    private int contentMatchTotal;

    private static readonly (string Label, string Id)[] Examples =
    {
        ("Paul Atreides", "char_PaulAtreides"),
        ("Arrakis", "loc_Arrakis"),
        ("Bene Gesserit", "org_BeneGesserit"),
        ("House Atreides", "house_Atreides"),
        ("Shai-Hulud", "bio_ShaiHulud"),
        ("The Butlerian Jihad", "event_ButlerianJihad"),
    };

    protected override void OnInitialized()
    {
        // The whole archive, unfiltered, so the seal line can say how much of it is still shut.
        // Read once: the seed data never changes, only the reader's progress does.
        everyRecord = Registry.GetAllEntities<DuneEntity>().ToList();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearch();
        }
    }

    private void RandomJump()
    {
        var entity = Registry.GetRandomEntity(Spoiler.IsVisible);
        if (entity is not null)
        {
            Nav.NavigateTo($"/entity/{entity.Id}");
        }
    }

    private void HandleSearch()
    {
        notFound = false;
        rawCandidates = new List<DuneEntity>();
        candidates = new List<DuneEntity>();
        rawContentMatches = new List<DuneEntity>();
        contentMatches = new List<DuneEntity>();
        lastQuery = query.Trim();

        if (string.IsNullOrWhiteSpace(lastQuery))
        {
            return;
        }

        // A new question, a new landing: the bump rebuilds the keyed result blocks, so
        // their settle replays instead of the rows swapping in place.
        searchEpoch++;

        var result = Registry.Resolve(lastQuery);

        // Resolve ignores spoilers and matches substrings and typos, so a sealed record can
        // land as the confident hit. I don't navigate there: the ID is the name, so the URL
        // spells it out. The filter drops it instead.
        if (result.Entity is not null && Spoiler.IsVisible(result.Entity))
        {
            Nav.NavigateTo($"/entity/{result.Entity.Id}");
            return;
        }

        // A record the query actually names beats one that just contains it in a longer
        // title, so "Muad'Dib" leads with the man, not the church built around him.
        // Without this I get whatever order the databank hands back.
        rawCandidates = result.Candidates
            .OrderByDescending(entity => ExactlyNamed(entity, lastQuery))
            .ThenBy(entity => entity.Name.Length)
            .ThenBy(entity => entity.Name)
            .ToList();

        // A record already listed by name doesn't get listed again as a text match.
        var alreadyNamed = new HashSet<string>(rawCandidates.Select(c => c.Id), StringComparer.OrdinalIgnoreCase);
        rawContentMatches = Registry.SearchByContent(lastQuery, Spoiler.IsVisible)
            .Where(entity => !alreadyNamed.Contains(entity.Id))
            .ToList();

        ApplySpoilerFilter();
    }

    // Changing reading progress moves two things at once: which results survive, and how much
    // of the archive is still sealed. The epoch bump rebuilds the seal line so its number can
    // never lag behind the control the reader just moved.
    private void OnProgressChanged()
    {
        sealEpoch++;
        RefilterCandidates();
    }

    // Reading progress moved without a new search. I rerun the text search rather than
    // re-filter it: progress decides how much of each entry is readable, so it changes
    // what the box can match, not just which records survive.
    private void RefilterCandidates()
    {
        if (!string.IsNullOrWhiteSpace(lastQuery))
        {
            // The name resolve reruns too. Only HandleSearch builds that candidate list, so a
            // query naming a sealed record kept saying "no matching records found" long after
            // it unlocked. I resolve here, not navigate: a chip click shouldn't move anyone.
            var resolved = Registry.Resolve(lastQuery);
            rawCandidates = resolved.Entity is not null
                ? new List<DuneEntity> { resolved.Entity }
                : resolved.Candidates
                    .OrderByDescending(entity => ExactlyNamed(entity, lastQuery))
                    .ThenBy(entity => entity.Name.Length)
                    .ThenBy(entity => entity.Name)
                    .ToList();

            var alreadyNamed = new HashSet<string>(rawCandidates.Select(c => c.Id), StringComparer.OrdinalIgnoreCase);
            rawContentMatches = Registry.SearchByContent(lastQuery, Spoiler.IsVisible)
                .Where(entity => !alreadyNamed.Contains(entity.Id))
                .ToList();
        }

        ApplySpoilerFilter();
    }

    private void ApplySpoilerFilter()
    {
        candidates = rawCandidates.Where(Spoiler.IsVisible).ToList();

        var ranked = rawContentMatches
            .Where(Spoiler.IsVisible)
            // A phrase in the one-line summary answers better than the same phrase
            // buried in a history, and an entry that keeps returning to it is more
            // about it. Name only breaks ties, so alphabetical never outranks relevance.
            .OrderByDescending(entity => InSummary(entity, lastQuery))
            .ThenByDescending(entity => Mentions(entity, lastQuery))
            .ThenBy(entity => entity.Name)
            .ToList();

        contentMatchTotal = ranked.Count;
        contentMatches = ranked.Take(MaxContentMatches).ToList();

        // Only talk about a failed search once one has actually run, so changing
        // reading progress on an untouched page never claims that nothing was found.
        notFound = !string.IsNullOrWhiteSpace(lastQuery)
            && candidates.Count == 0
            && contentMatches.Count == 0;
    }

    // The phrase itself, then its words longest first. Query words scatter through an
    // entry instead of sitting together, so display and ranking both fall back from the
    // whole phrase to its parts.
    private static IEnumerable<string> Needles(string query)
    {
        var trimmed = query.Trim();
        if (trimmed.Length >= 3)
        {
            yield return trimmed;
        }

        var words = trimmed
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(word => word.Length >= 3)
            .OrderByDescending(word => word.Length);

        foreach (var word in words)
        {
            yield return word;
        }
    }

    // Whether one of the names this record answers to is exactly what was typed,
    // instead of just containing it.
    private static bool ExactlyNamed(DuneEntity entity, string query)
    {
        if (string.Equals(entity.Name, query, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return entity.Aliases.Any(alias => string.Equals(alias, query, StringComparison.OrdinalIgnoreCase));
    }

    // Whether the record's one-line summary carries the search, which makes it a better
    // answer than one that only mentions it deep in a history.
    private static bool InSummary(DuneEntity entity, string query)
    {
        var summary = entity.ShortDescription ?? string.Empty;
        return Needles(query).Any(needle => summary.Contains(needle, StringComparison.OrdinalIgnoreCase));
    }

    // How often a record comes back to the strongest search word, a rough measure of what
    // the entry is about. I count only what this reader can see, so a held-back layer
    // never pushes a record up the results.
    private int Mentions(DuneEntity entity, string query)
    {
        var needle = Needles(query).LastOrDefault();
        if (string.IsNullOrEmpty(needle))
        {
            return 0;
        }

        var text = EntityRegistry.ReadableText(entity, Spoiler.IsVisible);

        int count = 0;
        int at = text.IndexOf(needle, StringComparison.OrdinalIgnoreCase);
        while (at >= 0)
        {
            count++;
            at = text.IndexOf(needle, at + needle.Length, StringComparison.OrdinalIgnoreCase);
        }

        return count;
    }

    // The stretch of an entry around the reader's phrase, so a match explains itself
    // instead of arriving as a bare name. Returns null when the phrase only matched
    // after punctuation was stripped, and the summary shows instead.
    private string? Snippet(DuneEntity entity, string query, int radius = 70)
    {
        // Opening history, then each layer the reader has earned, then the summary. A layer
        // still waiting on a book they haven't finished isn't in here, so an excerpt can
        // never quote a sentence the record is holding back.
        var sources = new List<string?> { entity.DetailedHistory };
        sources.AddRange(EntityRegistry.VisibleLayers(entity, Spoiler.IsVisible).Select(layer => layer.Text));
        sources.Add(entity.ShortDescription);

        foreach (var needle in Needles(query))
        {
            foreach (var source in sources)
            {
                if (string.IsNullOrEmpty(source))
                {
                    continue;
                }

                int found = source.IndexOf(needle, StringComparison.OrdinalIgnoreCase);
                if (found < 0)
                {
                    continue;
                }

                int start = Math.Max(0, found - radius);
                int end = Math.Min(source.Length, found + needle.Length + radius);

                // Grow out to whole words so the excerpt never opens or closes mid-word.
                while (start > 0 && !char.IsWhiteSpace(source[start - 1])) start--;
                while (end < source.Length && !char.IsWhiteSpace(source[end])) end++;

                var excerpt = source[start..end].Trim();
                return (start > 0 ? "…" : string.Empty) + excerpt + (end < source.Length ? "…" : string.Empty);
            }
        }

        return null;
    }
}
