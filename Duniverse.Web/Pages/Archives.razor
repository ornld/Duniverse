@page "/archives"
@inject EntityRegistry Registry
@inject NavigationManager Nav
@inject SpoilerSettings Spoiler

<PageTitle>Archives - Duniverse</PageTitle>

<div class="hero search-hero" style="background-image: linear-gradient(rgba(23, 19, 16, 0.82), rgba(23, 19, 16, 0.88)), url('/images/entity-front-background.webp');">
    <h1>Archives</h1>
    <p class="tagline">
        Search for anyone or anything in the Dune universe.
    </p>

    <div class="search-box">
        <input @bind="query" @bind:event="oninput" @onkeyup="HandleKeyUp"
               placeholder="Search a name or ID... e.g. Paul Atreides, Arrakis, Bene Gesserit" />
        <button @onclick="HandleSearch">Search</button>
    </div>

    @if (notFound)
    {
        <p class="no-results">No matching records found for "@lastQuery". Check the spelling and try again.</p>
    }

    @if (candidates.Count > 0)
    {
        <div class="candidates">
            <p>@candidates.Count records match "@lastQuery" - did you mean:</p>
            <ul>
                @foreach (var candidate in candidates)
                {
                    <li>
                        <a href="@($"/entity/{candidate.Id}")">@candidate.Name</a>
                        <span class="muted">@candidate.ShortDescription</span>
                    </li>
                }
            </ul>
        </div>
    }

    @* Records the query never names, but whose entry text mentions it. Kept visually
       below the name matches, and always a list instead of a jump, since a phrase
       found in a body of prose is a weaker claim than a name. *@
    @if (contentMatches.Count > 0)
    {
        <div class="candidates text-matches">
            <p>
                @(candidates.Count > 0 ? "Also mentioned" : "Mentioned")
                in the text of @contentMatchTotal @(contentMatchTotal == 1 ? "record" : "records")@(contentMatchTotal > contentMatches.Count ? $", closest {contentMatches.Count} first" : ""):
            </p>
            <ul>
                @foreach (var match in contentMatches)
                {
                    <li>
                        <a href="@($"/entity/{match.Id}")">@match.Name</a>
                        <span class="muted">@(Snippet(match, lastQuery) ?? match.ShortDescription)</span>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="examples">
        <span class="examples-label">Try:</span>
        @foreach (var example in Examples)
        {
            <a class="chip" href="@($"/entity/{example.Id}")">@example.Label</a>
        }
    </div>

    <p class="surprise-line">
        Not sure where to start?
        <button class="surprise-btn" @onclick="RandomJump">Surprise me</button>
    </p>

    <SpoilerControl OnChanged="RefilterCandidates" />
</div>

@code {
    private string query = "";
    private string lastQuery = "";
    private bool notFound;
    private List<DuneEntity> rawCandidates = new();
    private List<DuneEntity> candidates = new();
    private List<DuneEntity> rawContentMatches = new();
    private List<DuneEntity> contentMatches = new();

    // Enough to be useful without a common word burying the page in a hundred entries.
    private const int MaxContentMatches = 10;

    // How many records mention the phrase in total, before the display cap. Kept
    // separate so the heading can be honest about a list it only shows the top of.
    private int contentMatchTotal;

    private static readonly (string Label, string Id)[] Examples =
    {
        ("Paul Atreides", "char_PaulAtreides"),
        ("Arrakis", "loc_Arrakis"),
        ("Bene Gesserit", "org_BeneGesserit"),
        ("House Atreides", "house_Atreides"),
        ("Shai-Hulud", "bio_ShaiHulud"),
        ("The Butlerian Jihad", "event_ButlerianJihad"),
    };

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearch();
        }
    }

    private void RandomJump()
    {
        var entity = Registry.GetRandomEntity(Spoiler.IsVisible);
        if (entity is not null)
        {
            Nav.NavigateTo($"/entity/{entity.Id}");
        }
    }

    private void HandleSearch()
    {
        notFound = false;
        rawCandidates = new List<DuneEntity>();
        candidates = new List<DuneEntity>();
        rawContentMatches = new List<DuneEntity>();
        contentMatches = new List<DuneEntity>();
        lastQuery = query.Trim();

        if (string.IsNullOrWhiteSpace(lastQuery))
        {
            return;
        }

        var result = Registry.Resolve(lastQuery);

        // An exact ID or an unambiguous name still goes straight to the record.
        if (result.Entity is not null)
        {
            Nav.NavigateTo($"/entity/{result.Entity.Id}");
            return;
        }

        // A record the query actually names outranks one that just contains it inside
        // a longer title, so searching "Muad'Dib" leads with the man instead of the
        // church built around him. Without this the order is whatever the databank
        // happens to hand back.
        rawCandidates = result.Candidates
            .OrderByDescending(entity => ExactlyNamed(entity, lastQuery))
            .ThenBy(entity => entity.Name.Length)
            .ThenBy(entity => entity.Name)
            .ToList();

        // A record already listed by name doesn't get listed again as a text match.
        var alreadyNamed = new HashSet<string>(rawCandidates.Select(c => c.Id), StringComparer.OrdinalIgnoreCase);
        rawContentMatches = Registry.SearchByContent(lastQuery)
            .Where(entity => !alreadyNamed.Contains(entity.Id))
            .ToList();

        ApplySpoilerFilter();
    }

    // Re-apply the spoiler filter to the current results when the reader changes
    // their reading progress without running a new search.
    private void RefilterCandidates() => ApplySpoilerFilter();

    private void ApplySpoilerFilter()
    {
        candidates = rawCandidates.Where(Spoiler.IsVisible).ToList();

        var ranked = rawContentMatches
            .Where(Spoiler.IsVisible)
            // A phrase in the one-line summary answers the reader better than the same
            // phrase buried deep in a history, and an entry that keeps coming back to
            // the phrase is more about it than one that mentions it once. Name only
            // breaks ties, so alphabetical order never outranks relevance.
            .OrderByDescending(entity => InSummary(entity, lastQuery))
            .ThenByDescending(entity => Mentions(entity, lastQuery))
            .ThenBy(entity => entity.Name)
            .ToList();

        contentMatchTotal = ranked.Count;
        contentMatches = ranked.Take(MaxContentMatches).ToList();

        // Only talk about a failed search once one has actually run, so changing
        // reading progress on an untouched page never claims that nothing was found.
        notFound = !string.IsNullOrWhiteSpace(lastQuery)
            && candidates.Count == 0
            && contentMatches.Count == 0;
    }

    // The phrase itself, then its words longest first. The words of a query are often
    // scattered through an entry instead of sitting together, so anything reading the
    // text for display or ranking falls back from the whole phrase to its parts.
    private static IEnumerable<string> Needles(string query)
    {
        var trimmed = query.Trim();
        if (trimmed.Length >= 3)
        {
            yield return trimmed;
        }

        var words = trimmed
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(word => word.Length >= 3)
            .OrderByDescending(word => word.Length);

        foreach (var word in words)
        {
            yield return word;
        }
    }

    // Whether one of the names this record answers to is exactly what was typed,
    // instead of just containing it.
    private static bool ExactlyNamed(DuneEntity entity, string query)
    {
        if (string.Equals(entity.Name, query, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return entity.Aliases.Any(alias => string.Equals(alias, query, StringComparison.OrdinalIgnoreCase));
    }

    // Whether the record's one-line summary carries the search, which makes it a better
    // answer than one that only mentions it deep in a history.
    private static bool InSummary(DuneEntity entity, string query)
    {
        var summary = entity.ShortDescription ?? string.Empty;
        return Needles(query).Any(needle => summary.Contains(needle, StringComparison.OrdinalIgnoreCase));
    }

    // How often a record's text comes back to the strongest search word, as a rough
    // measure of how much the entry is actually about it.
    private static int Mentions(DuneEntity entity, string query)
    {
        var needle = Needles(query).LastOrDefault();
        if (string.IsNullOrEmpty(needle))
        {
            return 0;
        }

        var text = (entity.ShortDescription ?? string.Empty) + " " + (entity.DetailedHistory ?? string.Empty);

        int count = 0;
        int at = text.IndexOf(needle, StringComparison.OrdinalIgnoreCase);
        while (at >= 0)
        {
            count++;
            at = text.IndexOf(needle, at + needle.Length, StringComparison.OrdinalIgnoreCase);
        }

        return count;
    }

    // The stretch of an entry around the reader's phrase, so a match explains itself
    // instead of arriving as a bare name. Falls back to null when the phrase only
    // matched after punctuation was stripped, in which case the summary shows instead.
    private static string? Snippet(DuneEntity entity, string query, int radius = 70)
    {
        foreach (var needle in Needles(query))
        {
            foreach (var source in new[] { entity.DetailedHistory, entity.ShortDescription })
            {
                if (string.IsNullOrEmpty(source))
                {
                    continue;
                }

                int found = source.IndexOf(needle, StringComparison.OrdinalIgnoreCase);
                if (found < 0)
                {
                    continue;
                }

                int start = Math.Max(0, found - radius);
                int end = Math.Min(source.Length, found + needle.Length + radius);

                // Grow out to whole words so the excerpt never opens or closes mid-word.
                while (start > 0 && !char.IsWhiteSpace(source[start - 1])) start--;
                while (end < source.Length && !char.IsWhiteSpace(source[end])) end++;

                var excerpt = source[start..end].Trim();
                return (start > 0 ? "…" : string.Empty) + excerpt + (end < source.Length ? "…" : string.Empty);
            }
        }

        return null;
    }
}
