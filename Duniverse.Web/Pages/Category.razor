@page "/category/{Slug}"
@inject EntityRegistry Registry
@inject SpoilerSettings Spoiler

<PageTitle>@categoryTitle - Duniverse</PageTitle>

<a class="back-link" href="/">&larr; Home</a>

@* I branch on the unfiltered list. A visible-record test would conflate an unknown slug
   with a real category that's fully sealed, and the else branch says "Unknown category",
   so a whole shelf of the archive reads as nonexistent. *@
@if (allInCategory.Count > 0)
{
    <div class="hero category-hero category-@Slug.ToLowerInvariant()" style="@heroStyle">
        @* The drawer's own mark stands beside its name, at the one size on the site where
           these are drawn large enough to actually look at. *@
        <div class="category-heading">
            <Mark Name="@Slug.ToLowerInvariant()" CssClass="category-heading-mark" />
            <h1>@categoryTitle</h1>
        </div>
        <p class="tagline">
            @(items.Count == 1
                ? "To begin your study, one record lies open here. It tells its whole account."
                : $"To begin your study, choose freely among {items.Count} open records. Each tells its whole account.")
        </p>

        @* Only the worlds drawer opens onto the register; the other nine have no fiefs. *@
        @if (Slug.Equals("worlds", StringComparison.OrdinalIgnoreCase))
        {
            <a class="fief-door" href="/fiefs">See who holds each world &#8594;</a>
        }

        <div class="category-grid">
            @* Each card files itself: the drawer's mark and singular name lead, in the
               drawer's mineral. The deal caps at the tenth beat, so a big drawer lands
               as one motion. *@
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                <a class="category-tile" href="@($"/entity/{item.Id}")" style="--i: @Math.Min(i, 10)">
                    <span class="file-line"><Mark Name="@Slug.ToLowerInvariant()" CssClass="file-mark" />@filingLabel</span>
                    <strong>@item.Name</strong>
                    <span class="muted">@item.ShortDescription</span>
                </a>
            }
        </div>

        <ImperialSeal All="allInCategory" Scope="in this category" />
    </div>
}
else
{
    <h1>Unknown category</h1>
    <p>"@Slug" doesn't match a known category.</p>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private string categoryTitle = "";
    private string filingLabel = "";
    private string heroStyle = "";
    private List<DuneEntity> items = new();
    private List<DuneEntity> allInCategory = new();

    private static readonly Dictionary<string, string> CategoryBackgrounds = new()
    {
        ["artifacts"] = "artifacts.webp",
        ["disciplines"] = "disciplines.webp",
        ["flora-fauna"] = "flora-fauna.webp",
        ["historical-events"] = "historical-events.webp",
        ["houses"] = "houses.webp",
        ["organizations"] = "organizations.webp",
        ["personas"] = "personas.avif",
        ["theological-systems"] = "theological-systems.webp",
        ["vehicles"] = "vehicles.avif",
        ["worlds"] = "worlds.webp",
    };

    protected override void OnParametersSet()
    {
        var slug = Slug.ToLowerInvariant();

        // Title for the heading, singular for the cards' filing line: the same names the
        // Index panel files these drawers under.
        (categoryTitle, filingLabel, IEnumerable<DuneEntity> found) = slug switch
        {
            "artifacts" => ("Artifacts", "Artifact", Registry.GetAllEntities<Artifact>()),
            "disciplines" => ("Disciplines", "Discipline", Registry.GetAllEntities<Discipline>()),
            "flora-fauna" => ("Flora & Fauna", "Flora & Fauna", Registry.GetAllEntities<FloraFauna>()),
            "historical-events" => ("Historical Events", "Historical Event", Registry.GetAllEntities<HistoricalEvent>()),
            "houses" => ("Houses", "House", Registry.GetAllEntities<House>()),
            "organizations" => ("Organizations", "Organization", Registry.GetAllEntities<Organization>()),
            "personas" => ("Personas", "Persona", Registry.GetAllEntities<Persona>()),
            "theological-systems" => ("Theological Systems", "Theological System", Registry.GetAllEntities<TheologicalSystem>()),
            "vehicles" => ("Vehicles", "Vehicle", Registry.GetAllEntities<Vehicle>()),
            "worlds" => ("Worlds & Locations", "World", Registry.GetAllEntities<World>()),
            _ => ("", "", Enumerable.Empty<DuneEntity>())
        };

        // Kept unfiltered as well as filtered: the seal line needs to know how many records the
        // drawer actually holds, which is the one thing the filtered list can no longer say.
        allInCategory = found.ToList();
        items = allInCategory.Where(Spoiler.IsVisible).OrderBy(item => item.Name).ToList();

        heroStyle = CategoryBackgrounds.TryGetValue(slug, out var file)
            ? $"background-image: var(--scrim-soft), url('/images/categories/{file}');"
            : "";
    }
}
