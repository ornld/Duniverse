@page "/category/{Slug}"
@inject EntityRegistry Registry
@inject SpoilerSettings Spoiler

<PageTitle>@categoryTitle - Duniverse</PageTitle>

<a class="back-link" href="/">&larr; Home</a>

@if (items.Count > 0)
{
    <div class="hero category-hero category-@Slug.ToLowerInvariant()" style="@heroStyle">
        <h1>@categoryTitle</h1>
        <p class="tagline">@items.Count records. Select one to see its full entry and connections.</p>

        <div class="category-grid">
            @foreach (var item in items)
            {
                <a class="category-tile" href="@($"/entity/{item.Id}")">
                    <strong>@item.Name</strong>
                    <span class="muted">@item.ShortDescription</span>
                </a>
            }
        </div>

        <ImperialSeal All="allInCategory" Scope="in this drawer" />
    </div>
}
else
{
    <h1>Unknown category</h1>
    <p>"@Slug" doesn't match a known category.</p>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private string categoryTitle = "";
    private string heroStyle = "";
    private List<DuneEntity> items = new();
    private List<DuneEntity> allInCategory = new();

    private static readonly Dictionary<string, string> CategoryBackgrounds = new()
    {
        ["artifacts"] = "artifacts.webp",
        ["disciplines"] = "disciplines.webp",
        ["flora-fauna"] = "flora-fauna.webp",
        ["historical-events"] = "historical-events.webp",
        ["houses"] = "houses.webp",
        ["organizations"] = "organizations.webp",
        ["personas"] = "personas.jpg",
        ["theological-systems"] = "theological-systems.webp",
        ["vehicles"] = "vehicles.webp",
        ["worlds"] = "worlds.webp",
    };

    protected override void OnParametersSet()
    {
        var slug = Slug.ToLowerInvariant();

        (categoryTitle, IEnumerable<DuneEntity> found) = slug switch
        {
            "artifacts" => ("Artifacts", Registry.GetAllEntities<Artifact>()),
            "disciplines" => ("Disciplines", Registry.GetAllEntities<Discipline>()),
            "flora-fauna" => ("Flora & Fauna", Registry.GetAllEntities<FloraFauna>()),
            "historical-events" => ("Historical Events", Registry.GetAllEntities<HistoricalEvent>()),
            "houses" => ("Houses", Registry.GetAllEntities<House>()),
            "organizations" => ("Organizations", Registry.GetAllEntities<Organization>()),
            "personas" => ("Personas", Registry.GetAllEntities<Persona>()),
            "theological-systems" => ("Theological Systems", Registry.GetAllEntities<TheologicalSystem>()),
            "vehicles" => ("Vehicles", Registry.GetAllEntities<Vehicle>()),
            "worlds" => ("Worlds & Locations", Registry.GetAllEntities<World>()),
            _ => ("", Enumerable.Empty<DuneEntity>())
        };

        // Kept unfiltered as well as filtered: the seal line needs to know how many records the
        // drawer actually holds, which is the one thing the filtered list can no longer say.
        allInCategory = found.ToList();
        items = allInCategory.Where(Spoiler.IsVisible).OrderBy(item => item.Name).ToList();

        heroStyle = CategoryBackgrounds.TryGetValue(slug, out var file)
            ? $"background-image: linear-gradient(rgba(23, 19, 16, 0.82), rgba(23, 19, 16, 0.88)), url('/images/categories/{file}');"
            : "";
    }
}
