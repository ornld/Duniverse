@page "/terminology"
@inject EntityRegistry Registry
@inject SpoilerSettings Spoiler
@inject IJSRuntime JS

<PageTitle>Terminology - Duniverse</PageTitle>

<div class="hero" style="background-image: var(--scrim-mid), url('/images/terminology.webp');">
    <h1>Terminology of the Imperium</h1>
    <p class="tagline">
        A field dictionary of the Dune universe, intended to be true to the appendix Frank
        Herbert bound into the back of Dune.
    </p>

    <div class="search-box">
        <input value="@filter" @oninput="OnFilterChanged" placeholder="Filter terms... e.g. kanly, sietch, water" />
    </div>

    <div class="letter-chips">
        <button class="book-chip @(selectedLetter is null ? "selected" : "")" @onclick="() => SelectLetter(null)">All</button>
        @foreach (var letter in Letters)
        {
            <button class="book-chip @(selectedLetter == letter ? "selected" : "")" @onclick="() => SelectLetter(letter)">@letter</button>
        }
    </div>

    @if (FilteredTerms.Count == 0)
    {
        <p class="no-results">No terms match that filter.</p>
    }
    else
    {
        <dl class="glossary">
            @foreach (var term in PagedTerms)
            {
                <div class="glossary-entry">
                    <dt>@term.Term</dt>
                    <dd>
                        @term.Definition
                        @if (term.SeeEntityId is not null && LinkedName(term.SeeEntityId) is string linkedName)
                        {
                            <a class="glossary-see" href="@($"/entity/{term.SeeEntityId}")">See: @linkedName</a>
                        }
                    </dd>
                </div>
            }
        </dl>

        @if (PageCount > 1)
        {
            <nav class="glossary-pager" aria-label="Terminology pages">
                <span class="pager-status">Page @CurrentPage of @PageCount</span>
                <button class="pager-btn" disabled="@(CurrentPage == 1)" @onclick="() => GoToPage(CurrentPage - 1)" aria-label="Previous page">‹</button>
                @foreach (var page in PageNumbers)
                {
                    <button class="book-chip @(page == CurrentPage ? "selected" : "")"
                            @onclick="() => GoToPage(page)"
                            aria-current="@AriaCurrent(page)">
                        @(page)
                    </button>
                }
                <button class="pager-btn" disabled="@(CurrentPage == PageCount)" @onclick="() => GoToPage(CurrentPage + 1)" aria-label="Next page">›</button>
            </nav>
        }
    }
</div>

@code {
    // Doubled when the glossary lost its boxes: hanging definitions pack about twice as
    // many terms into the same screen, and 13 left the page ending well short of the fold.
    private const int PageSize = 26;

    private string filter = "";
    private char? selectedLetter;
    private int currentPage = 1;
    private List<GlossaryTerm> visibleTerms = new();

    protected override void OnInitialized()
    {
        // Spoiler-gated terms drop out here, the same deal entity pages follow.
        visibleTerms = GlossarySeeder.GetTerms()
            .Where(term => Spoiler.IsVisible(term.Tier))
            .OrderBy(term => term.Term, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private IReadOnlyList<char> Letters => visibleTerms
        .Select(term => char.ToUpperInvariant(term.Term[0]))
        .Distinct()
        .OrderBy(letter => letter)
        .ToList();

    private List<GlossaryTerm> FilteredTerms => visibleTerms
        .Where(term => selectedLetter is null || char.ToUpperInvariant(term.Term[0]) == selectedLetter)
        .Where(term => string.IsNullOrWhiteSpace(filter)
            || term.Term.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase)
            || term.Definition.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredTerms.Count / (double)PageSize));

    // A filter that shrinks the list could strand you on a page that no longer
    // exists, so the current page always clamps to what the filter leaves behind.
    private int CurrentPage => Math.Clamp(currentPage, 1, PageCount);

    private IEnumerable<int> PageNumbers => Enumerable.Range(1, PageCount);

    private string? AriaCurrent(int page) => page == CurrentPage ? "page" : null;

    private IEnumerable<GlossaryTerm> PagedTerms => FilteredTerms
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    // Any change to the filter can resize the result set, so paging starts over at one.
    private void OnFilterChanged(ChangeEventArgs e)
    {
        filter = e.Value?.ToString() ?? "";
        currentPage = 1;
    }

    private void SelectLetter(char? letter)
    {
        selectedLetter = letter;
        currentPage = 1;
    }

    private async Task GoToPage(int page)
    {
        var target = Math.Clamp(page, 1, PageCount);
        if (target == currentPage)
        {
            return;
        }

        currentPage = target;
        // Send the reader back to the top of the list, so a new page never opens
        // mid-scroll.
        await JS.InvokeVoidAsync("scrollTo", new { top = 0, behavior = "smooth" });
    }

    // The full record a term points at, shown only when the reader is allowed to see that
    // entity. A gated see-link would leak the name it points to, so it vanishes instead.
    private string? LinkedName(string entityId)
    {
        var linked = Registry.GetEntity(entityId);
        return linked is not null && Spoiler.IsVisible(linked) ? linked.Name : null;
    }
}
