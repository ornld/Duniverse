@page "/universe"
@inject EntityRegistry Registry
@inject GraphLayoutService LayoutService
@inject UniverseLayoutCache LayoutCache
@inject SpoilerSettings Spoiler
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Universe - Duniverse</PageTitle>

<div class="hero" style="background-image: var(--scrim-deep), url('/images/entity-graph-background.webp');">
    <h1>The Whole Duniverse</h1>
    <p class="tagline">
        Every record in the archive and every connection between them, drawn as one web.
        Your reading progress decides how much of it exists.
    </p>

    <div class="universe-find">
        <EntityPicker Label="Find a record" Placeholder="e.g. Lady Jessica"
                      Selected="@found" SelectedChanged="OnFoundChanged" />
    </div>

    <div class="universe-card" @ref="container">
        <div class="universe-controls">
            <button type="button" data-uni-zoom="in" title="Zoom in" aria-label="Zoom in">+</button>
            <button type="button" data-uni-zoom="out" title="Zoom out" aria-label="Zoom out">&minus;</button>
            <button type="button" data-uni-zoom="reset" title="Reset the view" aria-label="Reset the view">&#8634;</button>
        </div>

        @* Raised when someone scrolls over the graph expecting it to zoom. aria-hidden and
           never focusable: it answers a mouse gesture, and a reader who cannot make that
           gesture has the buttons above instead. *@
        <p class="universe-zoom-hint" aria-hidden="true">Hold ctrl and scroll to zoom</p>

        @* role="img" with a real description, deliberately. The constellation is a second
           view of records that Archives, the drawers and the find box above all reach in
           plain markup, so a screen reader is told what this is and spared 122 unlabelled
           dots it cannot do anything useful with. *@
        <svg class="universe-graph @(hoveredNodeId is null ? null : "has-hover")" viewBox="0 0 1600 1200" xmlns="http://www.w3.org/2000/svg"
             role="img" aria-label="@($"A constellation of {graph.Nodes.Count} records and {graph.Edges.Count} connections. Every record here can also be reached from the Archives, the category drawers, or the find box above.")">
            <g class="universe-world">
                @* The birth of the universe: every node carries a delay based on its distance
                   from the canvas center, so creation blooms outward as a wave, and a
                   thread only appears after the later of its two stars exists. The
                   @key wraps an inner group (never .universe-world itself, whose
                   element the pan module holds), so a reading-progress change births
                   the new universe from scratch. *@
                <g @key="birthEpoch">
                <g class="graph-edges">
                    @foreach (var edge in graph.Edges)
                    {
                        var source = nodesById[edge.SourceId];
                        var target = nodesById[edge.TargetId];
                        <line x1="@source.X.ToString(Inv)" y1="@source.Y.ToString(Inv)"
                              x2="@target.X.ToString(Inv)" y2="@target.Y.ToString(Inv)"
                              class="@(TouchesHovered(edge) ? "touches-hovered" : null)"
                              style="--birth: @EdgeBirthDelay(edge)" />
                    }
                </g>
                <g class="graph-nodes">
                    @foreach (var node in graph.Nodes)
                    {
                        <g class="graph-node category-@node.Category @(node.Id == found?.Id ? "is-found" : null) @(IsNearHovered(node) ? "near-hovered" : null) @(IsActive(node) ? "is-active" : null)"
                           transform="translate(@node.X.ToString(Inv), @node.Y.ToString(Inv))"
                           style="--birth: @NodeBirthDelay(node)"
                           @onpointerdown="e => RememberPointer(e)"
                           @onclick="() => Activate(node.Id)"
                           @onmouseover="() => hoveredNodeId = node.Id"
                           @onmouseout="() => OnMouseOut()">
                            @* The invisible circle is the hit target. Without it, the gap
                               between the dot and its label is dead space that eats
                               clicks. *@
                            <circle class="hit" r="17" />
                            <circle r="9" />
                            <text y="24">@Truncate(node.Name)</text>
                            <title>@node.Name: @node.ShortDescription</title>
                        </g>
                    }
                </g>
                </g>
            </g>
        </svg>
    </div>

    @* Two sentences rather than one, because the two kinds of reader do different things:
       a mouse hovers then clicks, a finger presses once to name a star and again to open
       it. The old line only described the mouse. *@
    <p class="graph-hint muted">
        @graph.Nodes.Count records and @graph.Edges.Count connections at your reading
        progress. Drag to travel. Hover any point to light its web and click it to open
        its record; on a touchscreen, press once to name a star and again to open it.
    </p>

    <div class="universe-legend">
        @foreach (var entry in Legend)
        {
            <span><Mark Name="@entry.Slug" CssClass="@($"legend-mark connection-cat category-{entry.Slug}")" />@entry.Label</span>
        }
    </div>

    <SpoilerControl OnChanged="OnSpoilerChanged" />
</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private const double Width = 1600;
    private const double Height = 1200;

    // An entity page can hand off a record via /universe?focus={id}. You land with
    // that star already selected and the camera gliding to it once the graph
    // attaches.
    [Parameter, SupplyParameterFromQuery(Name = "focus")]
    public string? FocusId { get; set; }

    private ElementReference container;
    private EntityGraph graph = new();
    private Dictionary<string, GraphNode> nodesById = new();
    private Dictionary<string, HashSet<string>> neighborsById = new(StringComparer.OrdinalIgnoreCase);
    private string? hoveredNodeId;
    private DuneEntity? found;
    private bool pendingReset;

    // Bumped on every rebuild so the keyed subtree recreates and the birth replays.
    private int birthEpoch;

    // How long the creation wave takes to reach the canvas corners, in seconds.
    private const double BirthWave = 1.6;

    private record LegendEntry(string Slug, string Label);

    private static readonly LegendEntry[] Legend =
    {
        new("personas", "Personas"),
        new("houses", "Houses"),
        new("organizations", "Organizations"),
        new("worlds", "Worlds"),
        new("artifacts", "Artifacts"),
        new("vehicles", "Vehicles"),
        new("disciplines", "Disciplines"),
        new("theological-systems", "Theological Systems"),
        new("historical-events", "Historical Events"),
        new("flora-fauna", "Flora & Fauna"),
    };

    protected override void OnInitialized()
    {
        Rebuild();

        // A handed-off record selects its star, so the picker shows the chip and the
        // camera knows where to fly once the graph attaches. A sealed or missing id
        // just gets ignored.
        if (FocusId is not null && nodesById.ContainsKey(FocusId)
            && Registry.GetEntity(FocusId) is { } entity && Spoiler.IsVisible(entity))
        {
            found = entity;
        }
    }

    // The whole visible archive. Hidden entities get excluded before the simulation
    // runs, so they neither appear nor bend the shape of what does. The layout is
    // deterministic for a given visible set, so the cache settles it once per set and
    // hands back a copy on every later visit; the simulation only runs the first time
    // a reading progress shows up. Building the graph stays cheap and has to happen
    // anyway, since its ordered node ids are the key.
    private void Rebuild()
    {
        var fresh = LayoutService.BuildFullGraph(Registry, Spoiler.IsVisible, Spoiler.IsVisible);
        graph = LayoutCache.GetOrAdd(
            UniverseLayoutCache.KeyFor(fresh),
            fresh,
            g => LayoutService.ApplyForceDirectedLayout(g, Width, Height, iterations: 220, gravity: 0.08, repulsionRange: 240));
        nodesById = graph.Nodes.ToDictionary(n => n.Id, StringComparer.OrdinalIgnoreCase);
        neighborsById = BuildNeighbors(graph);
        hoveredNodeId = null;
        birthEpoch++;
    }

    private static Dictionary<string, HashSet<string>> BuildNeighbors(EntityGraph graph)
    {
        var map = graph.Nodes.ToDictionary(
            n => n.Id,
            _ => new HashSet<string>(StringComparer.OrdinalIgnoreCase),
            StringComparer.OrdinalIgnoreCase);
        foreach (var edge in graph.Edges)
        {
            map[edge.SourceId].Add(edge.TargetId);
            map[edge.TargetId].Add(edge.SourceId);
        }
        return map;
    }

    private bool TouchesHovered(GraphEdge edge)
    {
        return hoveredNodeId is not null
            && (string.Equals(edge.SourceId, hoveredNodeId, StringComparison.OrdinalIgnoreCase)
                || string.Equals(edge.TargetId, hoveredNodeId, StringComparison.OrdinalIgnoreCase));
    }

    // The hovered star and its direct neighbors keep full presence as the rest of the
    // universe fades back. A star counts as near itself so it never fades under the
    // cursor.
    private bool IsNearHovered(GraphNode node)
    {
        return hoveredNodeId is not null
            && (string.Equals(node.Id, hoveredNodeId, StringComparison.OrdinalIgnoreCase)
                || (neighborsById.TryGetValue(hoveredNodeId, out var near) && near.Contains(node.Id)));
    }

    // The creation wave: a node's delay grows with its distance from the canvas center,
    // normalized against the far corners so the outermost stars land at BirthWave.
    private double BirthSeconds(GraphNode node)
    {
        double dx = node.X - Width / 2;
        double dy = node.Y - Height / 2;
        double corner = Math.Sqrt(Width * Width + Height * Height) / 2;
        return Math.Sqrt(dx * dx + dy * dy) / corner * BirthWave;
    }

    private string NodeBirthDelay(GraphNode node) =>
        BirthSeconds(node).ToString("0.00", Inv) + "s";

    // A connection can only exist once both of its stars do.
    private string EdgeBirthDelay(GraphEdge edge)
    {
        double later = Math.Max(BirthSeconds(nodesById[edge.SourceId]), BirthSeconds(nodesById[edge.TargetId]));
        return (later + 0.25).ToString("0.00", Inv) + "s";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("duneUniverse.attach", container);

            // A record handed in through ?focus= glides into view the same way the
            // find picker does, once the canvas is attached and can take a camera
            // move.
            if (found is not null && nodesById.TryGetValue(found.Id, out var target))
            {
                await JS.InvokeVoidAsync("duneUniverse.focusOn", target.X, target.Y, 2.6);
            }
        }

        if (pendingReset)
        {
            pendingReset = false;
            await JS.InvokeVoidAsync("duneUniverse.reset");
        }
    }

    private async Task OnFoundChanged(DuneEntity? entity)
    {
        found = entity;

        if (entity is not null && nodesById.TryGetValue(entity.Id, out var node))
        {
            // Glide the camera to the chosen record and zoom close enough to read it.
            await JS.InvokeVoidAsync("duneUniverse.focusOn", node.X, node.Y, 2.6);
        }
        else
        {
            await JS.InvokeVoidAsync("duneUniverse.reset");
        }
    }

    // A change in reading progress can add stars to the universe or take them away.
    // Rebuild from scratch and bring the camera home so the new whole is in frame.
    private void OnSpoilerChanged()
    {
        if (found is not null && !Spoiler.IsVisible(found))
        {
            found = null;
        }

        Rebuild();
        pendingReset = true;
    }

    // The one star singled out right now, as against the neighbourhood lit around it.
    private bool IsActive(GraphNode node)
        => string.Equals(node.Id, hoveredNodeId, StringComparison.OrdinalIgnoreCase);

    // Which kind of pointer opened the current interaction. Touch has no hover, so a tap
    // has to do the job hovering does on a mouse, and it cannot do both jobs at once.
    private bool lastPointerWasTouch;

    // The star a finger has already revealed. Kept apart from hoveredNodeId because that
    // one is also set by a passing mouse, and a mouse must never leave a node in the
    // "already named, next press opens it" state.
    private string? revealedByTouch;

    private void RememberPointer(PointerEventArgs e)
    {
        lastPointerWasTouch = e.PointerType is "touch" or "pen";
    }

    // A mouse leaving a node clears the highlight. A finger's stays put: there is nothing
    // for touch to move away to, and the label has to survive long enough to be read.
    private void OnMouseOut()
    {
        if (!lastPointerWasTouch)
        {
            hoveredNodeId = null;
        }
    }

    // Mouse keeps its one-click behaviour. Touch gets two steps: the first press names the
    // star and lights the threads it holds, the second on that same star opens the record.
    // Without this a reader on a phone can only find out what a dot was by leaving the page.
    private void Activate(string id)
    {
        if (lastPointerWasTouch && !string.Equals(revealedByTouch, id, StringComparison.OrdinalIgnoreCase))
        {
            revealedByTouch = id;
            hoveredNodeId = id;
            return;
        }

        GoTo(id);
    }

    private void GoTo(string id)
    {
        Nav.NavigateTo($"/entity/{id}");
    }

    private static string Truncate(string name) => name.Length > 18 ? name[..17] + "…" : name;
}
