@page "/trial"
@using System.Text.Json
@inject EntityRegistry Registry
@inject MentatTrialService Engine
@inject SpoilerSettings Spoiler
@inject IJSRuntime JS

<PageTitle>The Mentat Trial - Duniverse</PageTitle>

<div class="hero trial-hero" style="background-image: linear-gradient(rgba(23, 19, 16, 0.87), rgba(23, 19, 16, 0.92)), url('/images/entity-graph-background.webp');">
    <h1>The Mentat Trial</h1>
    <p class="tagline">
        Each day the archive seals one record and deals five clues, vague to specific.
        Name it within six guesses; every miss reports how many links your guess sits
        from the answer.
    </p>

    @if (answer is null)
    {
        <p class="no-results">
            No records are visible at your reading progress, so no trial can convene today.
        </p>
    }
    else
    {
        <ol class="trial-clues">
            @for (int i = 0; i < RevealedClues; i++)
            {
                var clue = clues[i];
                <li class="trial-clue" style="--i: @i" @key="i">
                    <span class="trial-clue-label">Clue @(i + 1)</span>
                    <span class="trial-clue-text">@clue</span>
                </li>
            }
        </ol>

        @if (!finished)
        {
            <p class="trial-counter">
                Guess @(history.Count + 1) of @MentatTrialService.MaxGuesses.
                @if (RevealedClues == MentatTrialService.ClueCount && history.Count == MentatTrialService.MaxGuesses - 1)
                {
                    <span>The clues are spent. One computation remains.</span>
                }
            </p>
            <div class="trial-guess">
                @* Keyed by an epoch bumped on every selection, so each handled guess
                   remounts the picker empty. The cleared value alone cannot reach it: the
                   parameter is null before and after a guess, and an unchanged parameter
                   never overwrites the chip the picker set for itself when the suggestion
                   was clicked. *@
                <EntityPicker @key="pickerEpoch" Label="Name the record"
                              Placeholder="e.g. Chani, Arrakis, the Spacing Guild..."
                              ShowDescriptions="false"
                              Selected="@pickerSelection" SelectedChanged="OnGuess" />
            </div>
        }

        @if (history.Count > 0)
        {
            <div class="trial-history">
                @for (int j = 0; j < history.Count; j++)
                {
                    var row = history[j];
                    <div class="trial-guess-row connection-cat category-@GraphLayoutService.CategorySlug(row.Entity) @(row.Result.IsCorrect ? "is-correct" : null)"
                         style="--i: @j" @key="row.Entity.Id">
                        <span class="endpoint-dot"></span>
                        <span class="trial-guess-name">@row.Entity.Name</span>
                        <span class="trial-guess-verdict muted">@Verdict(row.Result)</span>
                    </div>
                }
            </div>
        }

        @if (finished)
        {
            <div class="trial-reveal category-@GraphLayoutService.CategorySlug(answer)" style="--i: @history.Count">
                @if (won)
                {
                    @* Muad'Dib rising: naming the sealed record earns the naming moon, the way
                       taking the name of the second moon's shadow earned Paul his place in the
                       sietch. It climbs from behind the card's lower edge only at the moment of
                       the solve; a solved trial reopened later shows it already risen, a
                       completion mark rather than a replayed celebration. The mouse in the disc
                       is mare-like shading, not a drawing: it should resolve only for someone
                       who goes looking, the way the Fremen found it in the real moon. *@
                    <svg class="trial-moon @(justSolved ? "is-rising" : null)" width="64" height="64"
                         viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                        <defs>
                            <radialGradient id="trial-moon-glow" cx="0.5" cy="0.5" r="0.5">
                                <stop offset="0%" stop-color="rgba(236, 222, 194, 0.18)" />
                                <stop offset="70%" stop-color="rgba(236, 222, 194, 0.05)" />
                                <stop offset="100%" stop-color="rgba(236, 222, 194, 0)" />
                            </radialGradient>
                            <radialGradient id="trial-moon-face" cx="0.36" cy="0.3" r="0.9">
                                <stop offset="0%" stop-color="#d9cdb6" />
                                <stop offset="100%" stop-color="#a3957b" />
                            </radialGradient>
                            <clipPath id="trial-moon-disc">
                                <circle cx="32" cy="34" r="19" />
                            </clipPath>
                            <filter id="trial-moon-soft" x="-30%" y="-30%" width="160%" height="160%">
                                <feGaussianBlur stdDeviation="1.1" />
                            </filter>
                        </defs>
                        <circle cx="32" cy="34" r="30" fill="url(#trial-moon-glow)" />
                        <circle cx="32" cy="34" r="19" fill="url(#trial-moon-face)" />
                        <g class="trial-moon-mark" clip-path="url(#trial-moon-disc)"
                           filter="url(#trial-moon-soft)" fill="#5e5040" opacity="0.19">
                            @* Seated kangaroo mouse facing left: haunch, shoulder, head, one
                               ear, the tail swept beneath. One stray mare, held apart from the
                               figure, keeps the disc from reading as only a drawing. *@
                            <ellipse cx="37" cy="38" rx="8" ry="7" />
                            <ellipse cx="29.5" cy="35.5" rx="5.5" ry="4.6" />
                            <circle cx="24.5" cy="29.5" r="3.4" />
                            <ellipse cx="25.8" cy="24.4" rx="1.7" ry="3.1" transform="rotate(-12 25.8 24.4)" />
                            <path d="M41 42.5 C 38.5 47.5, 31 49.5, 23.5 46" fill="none" stroke="#5e5040"
                                  stroke-width="1.6" stroke-linecap="round" />
                            <ellipse cx="43" cy="23.5" rx="3" ry="2.1" opacity="0.45" />
                        </g>
                    </svg>
                    <blockquote class="epigraph trial-epigraph">
                        <p class="epigraph-text">@SolveLine()</p>
                        <footer class="epigraph-source">From the archivist's ledger</footer>
                    </blockquote>
                }
                else
                {
                    <p class="trial-verdict">
                        Six projections, and the record stands unnamed. The archive opens it regardless.
                    </p>
                }
                <a class="trial-record" href="@($"/entity/{answer.Id}")">
                    <span class="endpoint-dot connection-cat"></span>
                    <span>@answer.Name</span>
                </a>
                <p class="trial-record-meta muted">
                    Filed among the @MentatTrialService.CategoryLabel(answer). @answer.ShortDescription
                </p>
                <p class="trial-streak muted">@StreakLine()</p>
            </div>
        }
    }

    <p class="timeline-footnote muted">
        The trial honors your spoiler settings. Records past your reading progress stay out
        of the pool, so the day's answer never spoils what you have not read.
    </p>
</div>

@code {
    private const string StorageKey = "duniverse.trial.v1";

    private IReadOnlyList<DuneEntity> pool = Array.Empty<DuneEntity>();
    private string fingerprint = "";
    private DuneEntity? answer;
    private IReadOnlyList<string> clues = Array.Empty<string>();
    private List<GuessRow> history = new();
    private bool finished;
    private bool won;

    // True only for the render where the winning guess just landed, never on restore:
    // it gates the moonrise animation, so the moon climbs once at the moment of the
    // solve and simply hangs risen when a finished trial is reopened.
    private bool justSolved;
    private DuneEntity? pickerSelection;
    private int pickerEpoch;

    // The streak ledger survives across days in the same stored record as the day's trial.
    private int streak;
    private int longestStreak;
    private string? lastFinishedDate;

    // The trial's date freezes when the page loads, and every comparison against it,
    // including the streak's idea of yesterday, stays on that clock. A trial begun before
    // midnight and finished after it still counts for the day it was dealt.
    private DateOnly puzzleDate;
    private string today = "";

    private record GuessRow(DuneEntity Entity, TrialGuessResult Result);

    // The whole persisted state under duniverse.trial.v1: today's trial by date and pool
    // fingerprint, plus the streak ledger that outlives it.
    private record StoredTrial(
        string Date,
        string AnswerId,
        string PoolFingerprint,
        List<string> GuessIds,
        bool Finished,
        bool Won,
        int Streak,
        int LongestStreak,
        string? LastFinishedDate);

    // The first clue is free; each miss buys the next. A win freezes the count where it
    // stood, so the reveal shows only the clues that were actually earned.
    private int RevealedClues =>
        Math.Min(history.Count(row => !row.Result.IsCorrect) + 1, MentatTrialService.ClueCount);

    protected override async Task OnInitializedAsync()
    {
        await Spoiler.LoadAsync();

        puzzleDate = DateOnly.FromDateTime(DateTime.Now);
        today = puzzleDate.ToString("yyyy-MM-dd");

        pool = Engine.BuildPool(Spoiler.IsVisible);
        fingerprint = Engine.PoolFingerprint(pool);
        answer = Engine.SelectDaily(puzzleDate, pool);
        if (answer is not null)
        {
            clues = Engine.BuildClues(answer, Spoiler.IsVisible);
        }

        await RestoreAsync();
    }

    /// <summary>
    /// Rehydrates a trial saved earlier. The streak ledger always carries over; the day's
    /// guesses only do when the date and the pool fingerprint both match, so a reader who
    /// moved their reading progress mid-day starts that tier's puzzle fresh instead of
    /// replaying guesses against a different answer. A stored answer no longer visible is
    /// discarded without comment; its name must never surface from stale state.
    /// </summary>
    private async Task RestoreAsync()
    {
        StoredTrial? stored = null;
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrEmpty(raw))
            {
                stored = JsonSerializer.Deserialize<StoredTrial>(raw);
            }
        }
        catch
        {
            // localStorage can be blocked. The trial still plays; it just forgets overnight.
        }

        if (stored is null)
        {
            return;
        }

        streak = stored.Streak;
        longestStreak = stored.LongestStreak;
        lastFinishedDate = stored.LastFinishedDate;

        bool sameTrial = stored.Date == today
            && stored.PoolFingerprint == fingerprint
            && answer is not null
            && string.Equals(stored.AnswerId, answer.Id, StringComparison.OrdinalIgnoreCase)
            && Spoiler.IsVisible(answer);

        if (!sameTrial)
        {
            return;
        }

        // Replay the saved guesses through the live engine rather than trusting stored
        // verdicts, so the compass always reflects the current graph. Anything no longer
        // visible is dropped rather than named.
        foreach (var guessId in stored.GuessIds.Take(MentatTrialService.MaxGuesses))
        {
            var guess = Registry.GetEntity(guessId);
            if (guess is null || !Spoiler.IsVisible(guess))
            {
                continue;
            }

            var result = Engine.EvaluateGuess(guess, answer!, Spoiler.IsVisible);
            history.Add(new GuessRow(guess, result));
            if (result.IsCorrect)
            {
                break;
            }
        }

        won = history.Any(row => row.Result.IsCorrect);
        finished = won || history.Count >= MentatTrialService.MaxGuesses;
    }

    private async Task OnGuess(DuneEntity? entity)
    {
        pickerSelection = null;
        pickerEpoch++;

        if (entity is null || finished || answer is null)
        {
            return;
        }

        // Naming the same record twice teaches nothing, so it costs nothing.
        if (history.Any(row => string.Equals(row.Entity.Id, entity.Id, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var result = Engine.EvaluateGuess(entity, answer, Spoiler.IsVisible);
        history.Add(new GuessRow(entity, result));

        if (result.IsCorrect || history.Count >= MentatTrialService.MaxGuesses)
        {
            finished = true;
            won = result.IsCorrect;
            justSolved = result.IsCorrect;
            ApplyStreak();
        }

        await SaveAsync();
    }

    /// <summary>
    /// Finishing a trial extends the run when yesterday's was finished too, restarts it
    /// after a missed day, and counts at most once per day no matter how the state is
    /// replayed. Win or loss makes no difference; showing up and finishing is the run.
    /// </summary>
    private void ApplyStreak()
    {
        if (lastFinishedDate == today)
        {
            return;
        }

        var yesterday = puzzleDate.AddDays(-1).ToString("yyyy-MM-dd");
        streak = lastFinishedDate == yesterday ? streak + 1 : 1;
        longestStreak = Math.Max(longestStreak, streak);
        lastFinishedDate = today;
    }

    private async Task SaveAsync()
    {
        try
        {
            var stored = new StoredTrial(
                today,
                answer?.Id ?? "",
                fingerprint,
                history.Select(row => row.Entity.Id).ToList(),
                finished,
                won,
                streak,
                longestStreak,
                lastFinishedDate);
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(stored));
        }
        catch
        {
            // If persistence fails the trial still plays out in memory for this visit.
        }
    }

    private static string Verdict(TrialGuessResult result)
    {
        if (result.IsCorrect)
        {
            return "The record itself.";
        }

        var category = result.SameCategory ? "Same category" : "Different category";
        return $"{category}, {DistanceProse(result.LinkDistance)}.";
    }

    private static string DistanceProse(int? distance) => distance switch
    {
        null => "no visible chain joins them",
        1 => "one link from the answer",
        2 => "two links from the answer",
        3 => "three links from the answer",
        4 => "four links from the answer",
        5 => "five links from the answer",
        _ => $"{distance} links from the answer",
    };

    /// <summary>
    /// The solve set as an epigraph line. Guess counts arrive spelled out because the line
    /// is set type, and a chronicle does not print figures in its verse.
    /// </summary>
    private string SolveLine()
    {
        int used = history.Count;
        return used switch
        {
            1 => "Named in one, on the first projection.",
            5 => "Named in five, with one guess to spare.",
            6 => "Named in six, on the last computation.",
            _ => $"Named in {NumberWord(used)}, with {NumberWord(MentatTrialService.MaxGuesses - used)} guesses to spare.",
        };
    }

    private static string NumberWord(int n) => n switch
    {
        1 => "one",
        2 => "two",
        3 => "three",
        4 => "four",
        5 => "five",
        6 => "six",
        _ => n.ToString(),
    };

    private string StreakLine()
    {
        var line = streak == 1
            ? "Day one of a run. Return tomorrow to extend it."
            : $"You have finished the trial {streak} days running.";

        if (longestStreak > streak)
        {
            line += $" Your longest run reached {longestStreak} days.";
        }

        return line;
    }
}
