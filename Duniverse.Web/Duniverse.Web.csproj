<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The site only ever does ordinal/invariant string work, so skip shipping the ~1.5 MB
         ICU globalization data with the WASM payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Duniverse.Core/Duniverse.Core.csproj" />
  </ItemGroup>

  <!-- The four page scripts carry a .site suffix, and this rule puts the content hash in
       their published names, so a fresh deploy never meets a browser's stale copy. The SDK
       takes everything after the star as the extension and puts the hash in front of it,
       which is why the suffix has to be a real one, and it only rewrites scripts, so the
       sheet is versioned by the prerenderer instead. Files loaded by plain name from
       scripts (the worker, the decoder, the game) stay unfingerprinted. -->
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="SiteScripts" Pattern="*.site.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

</Project>
